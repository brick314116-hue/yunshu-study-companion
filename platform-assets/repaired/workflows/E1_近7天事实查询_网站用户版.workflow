None):\n    if isinstance(value, (list, tuple)): return value[0] if value else default\n    return default if value is None else value\n\ndef main(days=7):\n    try: days_value = int(scalar(days, 7) or 7)\n    except (TypeError, ValueError): days_value = 7\n    days_value = min(max(days_value, 1), 30)\n    end_time = datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    start_time = (datetime.utcnow() - timedelta(days=days_value)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    return {\"validation_passed\": True, \"start_time\": start_time, \"end_time\": end_time, \"error_message\": \"\"}\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":300,"width":240,"y":0,"height":79},"inputArgs":[{"bindValue":"5341021.days","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"key":"days","name":"days","require":true,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"start_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"end_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]}},{"id":5341023,"type":"Condition","name":"校验判断","workflowId":5258502,"created":"2026-09-14 11:57:04","modified":"2026-09-14 11:57:04","description":"校验判断","nextNodeIds":[5341024,5341025],"nextNodes":[],"preNodes":[],"spaceId":53260800,"virtualExecute":false,"unreachableNextNodeIds":[],"innerEndNode":false,"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5341022.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"key":"validation_passed","name":"validation_passed","require":true,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5341024],"uuid":"e1-valid"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5341025],"uuid":"e1-invalid"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":580,"width":300,"y":0,"height":119},"inputArgs":[],"outputArgs":[]}},{"created":"2026-08-31 20:48:48","description":"用户确认后的结构化情绪摘要","id":5341024,"innerEndNode":false,"modified":"2026-08-31 20:48:53","name":"mood_log","nextNodeIds":[5341026],"nextNodes":[],"nodeConfig":{"description":"用户确认后的结构化情绪摘要","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":352,"width":220,"y":-249.6899871826172,"height":79},"inputArgs":[{"bindValue":"5341022.start_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"key":"start_time","name":"start_time","require":true,"systemVariable":false},{"bindValue":"5341022.end_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"key":"end_time","name":"end_time","require":true,"systemVariable":false}],"name":"mood_log","originalTableConfig":"{\"creatorId\":1785217701,\"fieldList\":[{\"enabledFlag\":1,\"fieldDescription\":\"主键ID\",\"fieldName\":\"id\",\"fieldType\":6,\"nullableFlag\":-1,\"sortIndex\":0,\"systemFieldFlag\":1,\"uniqueFlag\":-1},{\"enabledFlag\":1,\"fieldDescription\":\"用户唯一标识\",\"fieldName\":\"uid\",\"fieldType\":1,\"nullableFlag\":-1,\"sortIndex\":1,\"systemFieldFlag\":1,\"uniqueFlag\":-1},{\"