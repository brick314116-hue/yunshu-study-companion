{"name":"学业任务保存_网站用户版","templateConfig":{"category":"FinanceAndCommerce","created":"2026-09-14 11:57:04","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"网站用户安全版：保存到 study_tasks，uid 由女娲系统变量 USER_UID 自动写入。","endNode":{"created":"2026-08-17 07:38:29","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5341206,"innerEndNode":false,"modified":"2026-08-17 07:38:29","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1670,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5341205.save_success","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"5341205.record_id","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"5341205.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258504},"icon":"https://agent.nuwax.com/api/f/s3/workflow/20260817/cc759d1769194d05a4c93ce2194ca7a7.png","id":5258504,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"用户是否确认保存","enable":true,"key":"44b638e3-c3a4-45ca-9ea1-79b2a5afa0ec","name":"save_confirmed","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"学习目标","enable":true,"key":"2b26edcc-5afc-4084-8585-6950f102b6a9","name":"goal","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"小任务步骤清单","enable":true,"key":"8e112659-3216-4fb1-b958-7f469c804a64","name":"steps","require":true,"systemVariable":false}],"modified":"2026-09-14 11:57:04","name":"学业任务保存_网站用户版","nodes":[{"created":"2026-08-17 07:38:29","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5341200,"innerEndNode":false,"modified":"2026-08-17 07:38:29","name":"开始","nextNodeIds":[5341201],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"用户是否确认保存","enable":true,"key":"44b638e3-c3a4-45ca-9ea1-79b2a5afa0ec","name":"save_confirmed","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"学习目标","enable":true,"key":"2b26edcc-5afc-4084-8585-6950f102b6a9","name":"goal","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"小任务步骤清单","enable":true,"key":"8e112659-3216-4fb1-b958-7f469c804a64","name":"steps","require":true,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258504},{"created":"2026-08-17 07:38:29","description":"必填字段与枚举校验，生成 expires_at（创建时刻+7天，UTC ISO 8601）","id":5341201,"innerEndNode":false,"modified":"2026-08-17 07:38:37","name":"字段校验","nextNodeIds":[5341202],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"学业任务保存字段校验与过期时间/初始状态生成\"\"\"\nfrom datetime import datetime, timedelta\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(goal=\"\", steps=\"\"):\n    if isinstance(goal, dict):\n        inputs = goal\n        goal = inputs.get(\"goal\", \"\")\n        steps = inputs.get(\"steps\", \"\")\n\n\n    goal = str(scalar(goal, \"\") or \"\").strip()\n    steps = str(scalar(steps, \"\") or \"\")\n\n    if not goal:\n        return _fail(\"学习目标不能为空\")\n    if not steps:\n        return _fail(\"任务步骤不能为空\")\n\n    expires_at = (datetime.utcnow() + timedelta(days=7)).strftime(\n        \"%Y-%m-%dT%H:%M:%SZ\")\n\n    return {\n        \"validation_passed\": True,\n        \"error_message\": \"\",\n        \"status\": \"pending\",\n        \"expires_at\": expires_at,\n    }\n\n\ndef _fail(msg):\n    return {\n        \"validation_passed\": False,\n        \"error_message\": msg,\n        \"status\": \"\",\n        \"expires_at\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5341200.goal","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"goal","require":false,"systemVariable":false},{"bindValue":"5341200.steps","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"steps","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"status","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"expires_at","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258504},{"created":"2026-08-17 07:38:29","description":"校验通过且用户已确认保存才写数据表","id":5341202,"innerEndNode":false,"modified":"2026-08-17 07:39:41","name":"写入条件判断","nextNodeIds":[5341203,5341204],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5341201.validation_passed","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"validation_passed","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}},{"compareType":"EQUAL","firstArg":{"bindValue":"5341200.save_confirmed","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"save_confirmed","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5341203],"uuid":"a23993d6033f46d686eef2d2025732df"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5341204],"uuid":"4c7ca23d32b1442dbfb3bdbfcbb3ede9"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":574,"width":300,"y":-149,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258504},{"created":"2026-08-17 07:38:29","description":"把未填写的空数组[]归一化为空字符串/0后再写表，避免数据新增节点写入失败","id":5341203,"innerEndNode":false,"modified":"2026-08-17 07:38:45","name":"写入字段归一化","nextNodeIds":[5341207],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"写入字段归一化：未填写的可选字段会被平台以空数组[]传递，\n直接写表会导致数据新增失败；此处统一归一化为字段类型的空值\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(goal='', steps='', status='', expires_at=''):\n    if isinstance(goal, dict):\n        inputs = goal\n        goal = inputs.get(\"goal\", '')\n        steps = inputs.get(\"steps\", '')\n        status = inputs.get(\"status\", '')\n        expires_at = inputs.get(\"expires_at\", '')\n\n\n    goal = scalar(goal, '')\n    steps = scalar(steps, '')\n    status = scalar(status, '')\n    expires_at = scalar(expires_at, '')\n\n    return {\n        \"goal\": goal,\n        \"steps\": steps,\n        \"status\": status,\n        \"expires_at\": expires_at,\n    }","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":940,"width":220,"y":-140,"height":79},"inputArgs":[{"bindValue":"5341200.goal","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"goal","require":false,"systemVariable":false},{"bindValue":"5341200.steps","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"steps","require":false,"systemVariable":false},{"bindValue":"5341201.status","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"status","require":false,"systemVariable":false},{"bindValue":"5341201.expires_at","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"expires_at","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"goal","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"steps","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"status","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"expires_at","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258504},{"created":"2026-08-17 07:38:29","description":"校验或确认未通过，不写数据表","id":5341204,"innerEndNode":false,"modified":"2026-08-17 07:38:37","name":"保存失败输出","nextNodeIds":[5341205],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"失败分支输出：校验或确认未通过，不写数据表\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(validation_passed=False, error_message=\"\", save_confirmed=False):\n    if isinstance(validation_passed, dict):\n        inputs = validation_passed\n        validation_passed = inputs.get(\"validation_passed\", False)\n        error_message = inputs.get(\"error_message\", \"\")\n        save_confirmed = inputs.get(\"save_confirmed\", False)\n\n\n    error_message = str(scalar(error_message, \"\") or \"\")\n    save_confirmed = scalar(save_confirmed, False)\n    if isinstance(save_confirmed, str):\n        save_confirmed = save_confirmed.strip().lower() == \"true\"\n\n    if not save_confirmed and not error_message:\n        error_message = \"用户未确认保存，未写入数据表\"\n    elif not error_message:\n        error_message = \"学习任务字段校验未通过\"\n\n    return {\n        \"save_success\": False,\n        \"record_id\": 0,\n        \"error_message\": error_message,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1000,"width":220,"y":30,"height":79},"inputArgs":[{"bindValue":"5341201.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5341201.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false},{"bindValue":"5341200.save_confirmed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"save_confirmed","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258504},{"created":"2026-08-17 07:38:29","description":"归并写表成功分支与失败分支；成败以失败分支是否执行为准，不依赖写表节点输出引用（UI重绑数据表可能重建其输出参数导致引用读空）","id":5341205,"innerEndNode":false,"modified":"2026-08-17 07:39:26","name":"输出归并","nextNodeIds":[5341206],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"输出归并：归并写表成功分支与失败分支。\n\n成败判定不依赖写表节点的 success/id 输出引用——UI 重新绑定数据表时\n平台可能重建写表节点的输出参数，导致引用读空（实测：写表成功但回执\nsave_success=false）。判定规则：\n1) 失败分支执行过（fail_error_message 非空）→ 保存失败；\n2) 写表节点 success 可读且明确为 false → 保存失败（真实写表失败）；\n3) 其余（走到本节点即写表分支已执行、引用可读性未知）→ 保存成功。\nrecord_id 尽力透传，引用被重建时可能为 0，不代表失败。\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(save_success=None, record_id=0, fail_error_message=\"\"):\n    if isinstance(save_success, dict):\n        inputs = save_success\n        save_success = inputs.get(\"save_success\", None)\n        record_id = inputs.get(\"record_id\", 0)\n        fail_error_message = inputs.get(\"fail_error_message\", \"\")\n\n\n    fail_error_message = str(scalar(fail_error_message, \"\") or \"\")\n\n    # 写表成败信号：None 表示引用不可读（被UI重建/清空），不等于失败\n    write_signal = scalar(save_success, None)\n    if isinstance(write_signal, str):\n        s = write_signal.strip().lower()\n        write_signal = None if s == \"\" else (s == \"true\")\n\n    try:\n        record_id = int(scalar(record_id, 0) or 0)\n    except (TypeError, ValueError):\n        record_id = 0\n\n    if fail_error_message:\n        return {\n            \"save_success\": False,\n            \"record_id\": 0,\n            \"error_message\": fail_error_message,\n        }\n    if write_signal is False:\n        return {\n            \"save_success\": False,\n            \"record_id\": 0,\n            \"error_message\": \"数据写入节点返回失败，请检查表字段映射\",\n        }\n    return {\n        \"save_success\": True,\n        \"record_id\": record_id,\n        \"error_message\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1350,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5341204.save_success","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"5341204.record_id","bindValueType":"Reference","dataType":"Number","description":"","enabl