e_ready = scalar(ok_delete_ready, False)\n    fail_error_message = str(scalar(fail_error_message, \"\") or \"\")\n\n    if ok_delete_ready:\n        return {\n            \"delete_ready\": True,\n            \"mood_log_delete_sql\": str(scalar(ok_mood_sql, \"\") or \"\"),\n            \"study_tasks_delete_sql\": str(scalar(ok_study_sql, \"\") or \"\"),\n            \"cognitive_practice_delete_sql\": str(scalar(ok_cognitive_sql, \"\") or \"\"),\n            \"error_message\": \"\",\n        }\n    return {\n        \"delete_ready\": False,\n        \"mood_log_delete_sql\": \"\",\n        \"study_tasks_delete_sql\": \"\",\n        \"cognitive_practice_delete_sql\": \"\",\n        \"error_message\": fail_error_message or \"删除未执行\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1562,"width":220,"y":14,"height":79},"inputArgs":[{"bindValue":"5341503.delete_ready","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"ok_delete_ready","require":false,"systemVariable":false},{"bindValue":"5341503.mood_log_delete_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"ok_mood_sql","require":false,"systemVariable":false},{"bindValue":"5341503.study_tasks_delete_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"ok_study_sql","require":false,"systemVariable":false},{"bindValue":"5341503.cognitive_practice_delete_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"ok_cognitive_sql","require":false,"systemVariable":false},{"bindValue":"5341504.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"fail_error_message","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":