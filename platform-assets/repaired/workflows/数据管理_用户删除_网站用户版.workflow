 \"\") or \"\")\n    if not error_message:\n        error_message = \"删除校验未通过\"\n\n    return {\n        \"delete_ready\": False,\n        \"mood_log_delete_sql\": \"\",\n        \"study_tasks_delete_sql\": \"\",\n        \"cognitive_practice_delete_sql\": \"\",\n        \"error_message\": error_message,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":980,"width":220,"y":30,"height":79},"inputArgs":[{"bindValue":"5341501.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5341501.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"delete_ready","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"mood_log_delete_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"study_tasks_delete_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"cognitive_practice_delete_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258507},{"created":"2026-08-18 21:44:06","description":"归并删除就绪分支与失败分支","id":5341505,"innerEndNode":false,"modified":"2026-08-18 21:44:22","name":"输出归并","nextNodeIds":[5341506],"nextNod