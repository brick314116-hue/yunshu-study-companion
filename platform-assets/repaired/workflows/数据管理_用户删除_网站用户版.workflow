 search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"删除就绪分支：透传三条删除 SQL\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(validation_passed=False, mood_log_delete_sql=\"\",\n         study_tasks_delete_sql=\"\", cognitive_practice_delete_sql=\"\"):\n    if isinstance(validation_passed, dict):\n        inputs = validation_passed\n        mood_log_delete_sql = inputs.get(\"mood_log_delete_sql\", \"\")\n        study_tasks_delete_sql = inputs.get(\"study_tasks_delete_sql\", \"\")\n        cognitive_practice_delete_sql = inputs.get(\"cognitive_practice_delete_sql\", \"\")\n\n\n    return {\n        \"delete_ready\": True,\n        \"mood_log_delete_sql\": str(scalar(mood_log_delete_sql, \"\") or \"\"),\n        \"study_tasks_delete_sql\": str(scalar(study_tasks_delete_sql, \"\") or \"\"),\n        \"cognitive_practice_delete_sql\": str(scalar(cognitive_practice_delete_sql, \"\") or \"\"),\n        \"error_message\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":980,"width":220,"y":-140,"height":79},"inputArgs":[{"bindValue":"5341501.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5341501.mood_log_delete_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"mood_log_delete_sql","require":false,"systemVariable":false},{"bindValue":"5341501.study_tasks_delete_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"study_tasks_delete_sql","require":false,"systemVariable":false},{"bindValue":"5341501.cognitive_practice_delete_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"cognitive_practice_delete_sql","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"delete_ready","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"mood_log_delete_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"study_tasks_delete_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"cognitive_practice_delete_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachab