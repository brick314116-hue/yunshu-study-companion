{"name":"情绪保存_网站用户版","templateConfig":{"category":"FinanceAndCommerce","created":"2026-09-14 11:57:04","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"网站用户安全版：保存到 mood_log，uid 由女娲系统变量 USER_UID 自动写入。","endNode":{"created":"2026-08-17 07:41:14","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5341106,"innerEndNode":false,"modified":"2026-08-17 07:41:14","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1670,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5341105.save_success","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"5341105.record_id","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"5341105.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},"icon":"https://agent.nuwax.com/api/f/s3/workflow/20260817/20d5890657f04c4eb4c7d533bdf4209c.png","id":5258503,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"用户是否确认保存","enable":true,"key":"785b3d7d-1e74-469c-8104-a398647cfaf0","name":"save_confirmed","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户确认的情绪名称","enable":true,"key":"59ab94f9-f0e8-4cac-9893-af596cffc286","name":"mood_type","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"用户自评强度1-5","enable":true,"key":"fa8311b3-8ed3-4b6f-bb97-4eb2aec06e56","name":"intensity_self","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"持续小时数，可为空","enable":true,"key":"3754aa9e-b984-43e5-934e-32ba7159936f","name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"诱因摘要，≤80字，可为空","enable":true,"key":"de81af15-5e69-4eab-905c-bffec0772df0","name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"对学业影响：无/轻微/明显，可为空","enable":true,"key":"81bb15a8-8485-4ed8-8db0-b53b694312fa","name":"impact_study","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"对生活影响：无/轻微/明显，可为空","enable":true,"key":"c994747d-4c18-4627-a567-f930d053b5c1","name":"impact_life","require":false,"systemVariable":false}],"modified":"2026-09-14 11:57:04","name":"情绪保存_网站用户版","nodes":[{"created":"2026-08-17 07:41:14","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5341100,"innerEndNode":false,"modified":"2026-08-17 07:41:14","name":"开始","nextNodeIds":[5341101],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"用户是否确认保存","enable":true,"key":"785b3d7d-1e74-469c-8104-a398647cfaf0","name":"save_confirmed","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户确认的情绪名称","enable":true,"key":"59ab94f9-f0e8-4cac-9893-af596cffc286","name":"mood_type","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"用户自评强度1-5","enable":true,"key":"fa8311b3-8ed3-4b6f-bb97-4eb2aec06e56","name":"intensity_self","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"持续小时数，可为空","enable":true,"key":"3754aa9e-b984-43e5-934e-32ba7159936f","name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"诱因摘要，≤80字，可为空","enable":true,"key":"de81af15-5e69-4eab-905c-bffec0772df0","name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"对学业影响：无/轻微/明显，可为空","enable":true,"key":"81bb15a8-8485-4ed8-8db0-b53b694312fa","name":"impact_study","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"对生活影响：无/轻微/明显，可为空","enable":true,"key":"c994747d-4c18-4627-a567-f930d053b5c1","name":"impact_life","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},{"created":"2026-08-17 07:41:14","description":"必填字段与枚举校验，生成 expires_at（创建时刻+7天，UTC ISO 8601）","id":5341101,"innerEndNode":false,"modified":"2026-08-31 20:26:01","name":"字段校验","nextNodeIds":[5341102],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"情绪保存字段校验与过期时间生成（uid/created 由数据表系统字段自动填充）\"\"\"\nfrom datetime import datetime, timedelta\n\nVALID_IMPACT = [\"无\", \"轻微\", \"明显\"]\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(mood_type=\"\", intensity_self=0, duration_hours=\"\",\n         trigger_summary=\"\", impact_study=\"\", impact_life=\"\"):\n    if isinstance(mood_type, dict):\n        inputs = mood_type\n        mood_type = inputs.get(\"mood_type\", \"\")\n        intensity_self = inputs.get(\"intensity_self\", 0)\n        duration_hours = inputs.get(\"duration_hours\", \"\")\n        trigger_summary = inputs.get(\"trigger_summary\", \"\")\n        impact_study = inputs.get(\"impact_study\", \"\")\n        impact_life = inputs.get(\"impact_life\", \"\")\n\n\n    mood_type = str(scalar(mood_type, \"\") or \"\").strip()\n    trigger_summary = str(scalar(trigger_summary, \"\") or \"\")\n    impact_study = str(scalar(impact_study, \"\") or \"\")\n    impact_life = str(scalar(impact_life, \"\") or \"\")\n\n    if not mood_type:\n        return _fail(\"情绪名称不能为空\")\n\n    try:\n        intensity_val = int(scalar(intensity_self, 0) or 0)\n    except (TypeError, ValueError):\n        return _fail(\"情绪强度必须是整数\")\n\n    if intensity_val < 1 or intensity_val > 5:\n        return _fail(\"情绪强度必须在1-5之间\")\n\n    if impact_study and impact_study not in VALID_IMPACT:\n        return _fail(\"学业影响取值非法，只能是无、轻微或明显\")\n    if impact_life and impact_life not in VALID_IMPACT:\n        return _fail(\"生活影响取值非法，只能是无、轻微或明显\")\n\n    if len(trigger_summary) > 80:\n        return _fail(\"诱因摘要超过80字\")\n\n    expires_at = (datetime.utcnow() + timedelta(days=7)).strftime(\n        \"%Y-%m-%dT%H:%M:%SZ\")\n\n    return {\n        \"validation_passed\": True,\n        \"error_message\": \"\",\n        \"expires_at\": expires_at,\n    }\n\n\ndef _fail(msg):\n    return {\n        \"validation_passed\": False,\n        \"error_message\": msg,\n        \"expires_at\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5341100.mood_type","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"mood_type","require":false,"systemVariable":false},{"bindValue":"5341100.intensity_self","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"intensity_self","require":false,"systemVariable":false},{"bindValue":"5341100.duration_hours","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"5341100.trigger_summary","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5341100.impact_study","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"impact_study","require":false,"systemVariable":false},{"bindValue":"5341100.impact_life","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"impact_life","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"expires_at","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},{"created":"2026-08-17 07:41:14","description":"校验通过且用户已确认保存才写数据表","id":5341102,"innerEndNode":false,"modified":"2026-08-17 07:41:47","name":"写入条件判断","nextNodeIds":[5341104,5341103],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5341101.validation_passed","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"validation_passed","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}},{"compareType":"EQUAL","firstArg":{"bindValue":"5341100.save_confirmed","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"save_confirmed","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5341103],"uuid":"a5ee402f5f2d4402beee7c22c4e6b8f0"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5341104],"uuid":"e5b4b60704044a03833a205143547cdc"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":640,"width":300,"y":-60,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},{"created":"2026-08-17 07:41:14","description":"把未填写的空数组[]归一化为空字符串/0后再写表，避免数据新增节点写入失败","id":5341103,"innerEndNode":false,"modified":"2026-08-31 20:44:02","name":"写入字段归一化","nextNodeIds":[5341107],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"写入字段归一化：未填写的可选字段会被平台以空数组[]传递，\n直接写表会导致数据新增失败；此处统一归一化为字段类型的空值\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(mood_type='', intensity_self=0, duration_hours=0, trigger_summary='', impact_study='', impact_life='', expires_at=''):\n    if isinstance(mood_type, dict):\n        inputs = mood_type\n        mood_type = inputs.get(\"mood_type\", '')\n        intensity_self = inputs.get(\"intensity_self\", 0)\n        duration_hours = inputs.get(\"duration_hours\", 0)\n        trigger_summary = inputs.get(\"trigger_summary\", '')\n        impact_study = inputs.get(\"impact_study\", '')\n        impact_life = inputs.get(\"impact_life\", '')\n        expires_at = inputs.get(\"expires_at\", '')\n\n\n    mood_type = scalar(mood_type, '')\n    intensity_self = scalar(intensity_self, 0)\n    duration_hours = scalar(duration_hours, 0)\n    trigger_summary = scalar(trigger_summary, '')\n    impact_study = scalar(impact_study, '')\n    impact_life = scalar(impact_life, '')\n    expires_at = scalar(expires_at, '')\n\n    return {\n        \"mood_type\": mood_type,\n        \"intensity_self\": intensity_self,\n        \"duration_hours\": duration_hours,\n        \"trigger_summary\": trigger_summary,\n        \"impact_study\": impact_study,\n        \"impact_life\": impact_life,\n        \"expires_at\": expires_at,\n    }","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":902,"width":220,"y":-308,"height":79},"inputArgs":[{"bindValue":"5341100.mood_type","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"mood_type","require":false,"systemVariable":false},{"bindValue":"5341100.intensity_self","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"intensity_self","require":false,"systemVariable":false},{"bindValue":"5341100.duration_hours","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"5341100.trigger_summary","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5341100.impact_study","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"impact_study","require":false,"systemVariable":false},{"bindValue":"5341100.impact_life","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"impact_life","require":false,"systemVariable":false},{"bindValue":"5341101.expires_at","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"expires_at","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"mood_type","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"name":"intensity_self","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"impact_study","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"impact_life","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"expires_at","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},{"created":"2026-08-17 07:41:14","description":"校验或确认未通过，不写数据表","id":5341104,"innerEndNode":false,"modified":"2026-08-31 20:26:06","name":"保存失败输出","nextNodeIds":[5341105],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"失败分支输出：校验或确认未通过，不写数据表\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(validation_passed=False, error_message=\"\", save_confirmed=False):\n    if isinstance(validation_passed, dict):\n        inputs = validation_passed\n        validation_passed = inputs.get(\"validation_passed\", False)\n        error_message = inputs.get(\"error_message\", \"\")\n        save_confirmed = inputs.get(\"save_confirmed\", False)\n\n\n    error_message = str(scalar(error_message, \"\") or \"\")\n    save_confirmed = scalar(save_confirmed, False)\n    if isinstance(save_confirmed, str):\n        save_confirmed = save_confirmed.strip().lower() == \"true\"\n\n    if not save_confirmed and not error_message:\n        error_message = \"用户未确认保存，未写入数据表\"\n    elif not error_message:\n        error_message = \"情绪字段校验未通过\"\n\n    return {\n        \"save_success\": False,\n        \"record_id\": 0,\n        \"error_message\": error_message,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":1000,"width":220,"y":30,"height":79},"inputArgs":[{"bindValue":"5341101.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5341101.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false},{"bindValue":"5341100.save_confirmed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"save_confirmed","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},{"created":"2026-08-17 07:41:14","description":"归并写表成功分支与失败分支；成败以失败分支是否执行为准，不依赖写表节点输出引用（UI重绑数据表可能重建其输出参数导致引用读空）","id":5341105,"innerEndNode":false,"modified":"2026-08-31 20:44:13","name":"输出归并","nextNodeIds":[5341106],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"输出归并：归并写表成功分支与失败分支。\n\n成败判定不依赖写表节点的 success/id 输出引用——UI 重新绑定数据表时\n平台可能重建写表节点的输出参数，导致引用读空（实测：写表成功但回执\nsave_success=false）。判定规则：\n1) 失败分支执行过（fail_error_message 非空）→ 保存失败；\n2) 写表节点 success 可读且明确为 false → 保存失败（真实写表失败）；\n3) 其余（走到本节点即写表分支已执行、引用可读性未知）→ 保存成功。\nrecord_id 尽力透传，引用被重建时可能为 0，不代表失败。\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(save_success=None, record_id=0, fail_error_message=\"\"):\n    if isinstance(save_success, dict):\n        inputs = save_success\n        save_success = inputs.get(\"save_success\", None)\n        record_id = inputs.get(\"record_id\", 0)\n        fail_error_message = inputs.get(\"fail_error_message\", \"\")\n\n\n    fail_error_message = str(scalar(fail_error_message, \"\") or \"\")\n\n    # 写表成败信号：None 表示引用不可读（被UI重建/清空），不等于失败\n    write_signal = scalar(save_success, None)\n    if isinstance(write_signal, str):\n        s = write_signal.strip().lower()\n        write_signal = None if s == \"\" else (s == \"true\")\n\n    try:\n        record_id = int(scalar(record_id, 0) or 0)\n    except (TypeError, ValueError):\n        record_id = 0\n\n    if fail_error_message:\n        return {\n            \"save_success\": False,\n            \"record_id\": 0,\n            \"error_message\": fail_error_message,\n        }\n    if write_signal is False:\n        return {\n            \"save_success\": False,\n            \"record_id\": 0,\n            \"error_message\": \"数据写入节点返回失败，请检查表字段映射\",\n        }\n    return {\n        \"save_success\": True,\n        \"record_id\": record_id,\n        \"error_message\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":1350,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5341107.success","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"5341107.id","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"5341104.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"fail_error_message","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"save_success","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5258503},{"created":"2026-08-17 07:41:14","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5341106,"innerEndNode":false,"modi