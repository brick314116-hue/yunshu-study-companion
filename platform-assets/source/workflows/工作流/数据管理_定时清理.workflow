tion":"工作流起始节点，用于设定启动工作流需要的信息","id":5334060,"innerEndNode":false,"modified":"2026-08-31 20:48:48","name":"开始","nextNodeIds":[5334061],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"定时任务触发时可为空；手动试运行时可填任意值","enable":true,"key":"daa6fa0b-5210-4661-ae15-8ddcf38acc50","name":"manual_trigger","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5259699},{"created":"2026-08-31 20:48:48","description":"生成当前时间与三张表的过期记录删除SQL；导入后可在UI中追加SQL自定义节点执行","id":5334061,"innerEndNode":false,"modified":"2026-08-31 20:48:48","name":"清理参数生成","nextNodeIds":[5334063],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"定时清理参数生成：生成当前时间与三张表的过期记录删除 SQL\n（expires_at 为 ISO 8601 字符串，字典序与时间顺序一致，可直接比较）\"\"\"\nfrom datetime import datetime, timedelta\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(manual_trigger=\"\"):\n    if isinstance(manual_trigger, dict):\n        manual_trigger = manual_trigger.get(\"manual_trigger\", \"\")\n\n\n    threshold = (datetime.utcnow() - timedelta(days=7)).strftime(\n        \"%Y-%m-%dT%H:%M:%SZ\")\n\n    return {\n        \"current_time\": datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"threshold\": threshold,\n        \"mood_log_sql\": \"DELETE FROM mood_log WHERE expires_at <= '%s'\" % threshold,\n        \"study_tasks_sql\": \"DELETE FROM study_tasks WHERE expires_at <= '%s'\" % threshold,\n        \"cognitive_practice_sql\": \"DELETE FROM cognitive_practice WHERE expires_at <= '%s'\" % threshold,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5334060.manual_trigger","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"manual_trigger","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"current_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"mood_log_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"study_tasks_sql","require":false,"s