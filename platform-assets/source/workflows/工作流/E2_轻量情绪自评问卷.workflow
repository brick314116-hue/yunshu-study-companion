{"name":"E2_轻量情绪自评问卷","templateConfig":{"category":"FinanceAndCommerce","created":"2026-08-16 19:51:09","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"8题情绪状态自评：逐题作答后计分（8-40），仅输出事实区间描述与通用调节建议；不诊断、不常模比较、不做风险分级；默认不写数据表","endNode":{"created":"2026-08-16 19:51:09","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5321994,"innerEndNode":false,"modified":"2026-08-16 19:51:09","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1590,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5321993.scoring_ok","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"scoring_ok","require":false,"systemVariable":false},{"bindValue":"5321993.total_score","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"total_score","require":false,"systemVariable":false},{"bindValue":"5321993.range_label","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"range_label","require":false,"systemVariable":false},{"bindValue":"5321993.range_desc","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"range_desc","require":false,"systemVariable":false},{"bindValue":"5321993.description","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"description","require":false,"systemVariable":false},{"bindValue":"5321993.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257647},"icon":"https://agent.nuwax.com/api/f/s3/icon/20260731/9bbf0c188a0c4a93a53e160253661348.svg","id":5257647,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"8题作答结果，格式：1=有时,2=经常,... 或 JSON（键为题号，值为 从不/偶尔/有时/经常/总是）","enable":true,"key":"566c817b-268a-45bf-a6fe-749c7bafc6a4","name":"answers","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"3ed2f18f-0a9e-4e70-9c4c-3cf5269255f2","name":"owner_uid","require":false,"systemVariable":false}],"modified":"2026-08-22 14:17:30","name":"E2_轻量情绪自评问卷","nodes":[{"created":"2026-08-16 19:51:09","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321988,"innerEndNode":false,"modified":"2026-08-16 19:51:09","name":"开始","nextNodeIds":[5321989],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"8题作答结果，格式：1=有时,2=经常,... 或 JSON（键为题号，值为 从不/偶尔/有时/经常/总是）","enable":true,"key":"566c817b-268a-45bf-a6fe-749c7bafc6a4","name":"answers","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"3ed2f18f-0a9e-4e70-9c4c-3cf5269255f2","name":"owner_uid","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257647},{"created":"2026-08-16 19:51:09","description":"8题计分（总分8-40）并匹配事实区间；不诊断、不比较、不分级","id":5321989,"innerEndNode":false,"modified":"2026-08-17 07:46:32","name":"问卷计分","nextNodeIds":[5321990],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"轻量情绪自评问卷计分：8题、每题1-5分、总分8-40，仅事实区间描述\n（不诊断、不常模比较、不定正常/异常、不做风险分级、不预测未来）\"\"\"\nimport json\nimport re\n\nQUESTIONNAIRE = {\n    \"questions\": [\n        {\"id\": 1, \"text\": \"我感到心情平静\", \"score\": [1, 2, 3, 4, 5]},\n        {\"id\": 2, \"text\": \"我容易烦躁或生气\", \"score\": [5, 4, 3, 2, 1]},\n        {\"id\": 3, \"text\": \"我对平时感兴趣的事仍然有兴趣\", \"score\": [1, 2, 3, 4, 5]},\n        {\"id\": 4, \"text\": \"我感到紧张或焦虑\", \"score\": [5, 4, 3, 2, 1]},\n        {\"id\": 5, \"text\": \"我能集中注意力做手上的事\", \"score\": [1, 2, 3, 4, 5]},\n        {\"id\": 6, \"text\": \"我对未来感到有信心\", \"score\": [1, 2, 3, 4, 5]},\n        {\"id\": 7, \"text\": \"我感到孤单\", \"score\": [5, 4, 3, 2, 1]},\n        {\"id\": 8, \"text\": \"我睡得好\", \"score\": [1, 2, 3, 4, 5]},\n    ],\n    \"options\": [\"从不\", \"偶尔\", \"有时\", \"经常\", \"总是\"],\n    \"result_ranges\": [\n        {\"min\": 8, \"max\": 16, \"label\": \"状态良好\",\n         \"desc\": \"最近整体状态比较平稳，继续保持。\"},\n        {\"min\": 17, \"max\": 24, \"label\": \"轻度波动\",\n         \"desc\": \"有些小情绪起伏，在学业压力大的时候完全正常。\"},\n        {\"min\": 25, \"max\": 32, \"label\": \"明显压力\",\n         \"desc\": \"近期压力感受比较明显，建议多关注自己的睡眠和作息。\"},\n        {\"min\": 33, \"max\": 40, \"label\": \"需要关注\",\n         \"desc\": \"最近可能比较辛苦。如果这种感觉持续两周以上，建议和学校心理老师聊聊。\"},\n    ],\n}\n\n\ndef _parse_answers(raw):\n    \"\"\"兼容 dict、JSON字符串、'1=有时,2=经常' 文本、空数组\"\"\"\n    if isinstance(raw, dict):\n        return {str(k).strip(): str(v).strip() for k, v in raw.items()}\n    if isinstance(raw, (list, tuple)):\n        merged = {}\n        for i, v in enumerate(raw):\n            if v not in (None, \"\"):\n                merged[str(i + 1)] = str(v).strip()\n        return merged\n    text = str(raw or \"\").strip()\n    if not text:\n        return {}\n    text = text.strip(\"`\")\n    if text.startswith(\"{\"):\n        try:\n            data = json.loads(text)\n            if isinstance(data, dict):\n                return {str(k).strip(): str(v).strip() for k, v in data.items()}\n        except ValueError:\n            pass\n    pairs = re.split(r\"[,，;；\\n]+\", text)\n    merged = {}\n    for p in pairs:\n        p = p.strip()\n        if not p:\n            continue\n        m = re.match(r\"^(\\d+)\\s*[=:：]\\s*(.+)$\", p)\n        if m:\n            merged[m.group(1)] = m.group(2).strip()\n    return merged\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(answers=\"\"):\n    if isinstance(answers, dict) and \"answers\" in answers:\n        inputs = answers\n        answers = inputs.get(\"answers\", \"\")\n\n\n    options = QUESTIONNAIRE[\"options\"]\n    parsed = _parse_answers(scalar(answers, \"\"))\n    if not parsed:\n        return _fail(\"没有收到任何作答，请先逐题作答后再计分\")\n\n    total = 0\n    missing = []\n    invalid = []\n    for q in QUESTIONNAIRE[\"questions\"]:\n        qid = str(q[\"id\"])\n        ans = parsed.get(qid, \"\")\n        if not ans:\n            missing.append(qid)\n            continue\n        if ans not in options:\n            try:\n                idx = int(ans) - 1\n                if 0 <= idx < len(options):\n                    total += q[\"score\"][idx]\n                    continue\n            except (TypeError, ValueError):\n                pass\n            invalid.append(\"%s(%s)\" % (qid, ans))\n            continue\n        total += q[\"score\"][options.index(ans)]\n\n    if missing or invalid:\n        parts = []\n        if missing:\n            parts.append(\"第%s题未作答\" % \"、\".join(missing))\n        if invalid:\n            parts.append(\"第%s题作答无效（请用：从不/偶尔/有时/经常/总是）\"\n                         % \"、\".join(invalid))\n        return _fail(\"；\".join(parts))\n\n    label = \"\"\n    desc = \"\"\n    for rng in QUESTIONNAIRE[\"result_ranges\"]:\n        if rng[\"min\"] <= total <= rng[\"max\"]:\n            label = rng[\"label\"]\n            desc = rng[\"desc\"]\n            break\n\n    summary_text = (\n        \"问卷共8题，总分%s分（区间8-40），落在“%s”区间。%s\"\n        % (total, label, desc)\n    )\n    if label == \"需要关注\":\n        summary_text += \"建议和心理老师聊聊，有人分担会好很多。\"\n    summary_text += \"本次结果仅是事实描述，不是诊断，也不和别人比较。\"\n\n    return {\n        \"scoring_ok\": True,\n        \"total_score\": total,\n        \"range_label\": label,\n        \"range_desc\": desc,\n        \"summary_text\": summary_text,\n        \"error_message\": \"\",\n    }\n\n\ndef _fail(msg):\n    return {\n        \"scoring_ok\": False,\n        \"total_score\": 0,\n        \"range_label\": \"\",\n        \"range_desc\": \"\",\n        \"summary_text\": \"\",\n        \"error_message\": msg,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":276,"width":220,"y":-47.5,"height":79},"inputArgs":[{"bindValue":"5321988.answers","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"answers","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"scoring_ok","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"name":"total_score","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"range_label","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"range_desc","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"summary_text","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257647},{"created":"2026-08-16 19:51:09","description":"计分成功才生成事实描述","id":5321990,"innerEndNode":false,"modified":"2026-08-17 07:46:32","name":"计分判断","nextNodeIds":[5321991,5321992],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5321989.scoring_ok","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"scoring_ok","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5321991],"uuid":"83df3a8eca53497a8b26b6d8b0085b07"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5321992],"uuid":"3271d0ec8a0441c2ad65933260ef5e7a"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":552,"width":300,"y":-89,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257647},{"created":"2026-08-16 19:51:09","description":"仅事实描述问卷结果，不超过2句，禁止诊断/趋势/风险等级/常模比较","id":5321991,"innerEndNode":false,"modified":"2026-08-22 14:17:27","name":"事实描述","nextNodeIds":[5321993],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":1,"specificContent":{},"timeout":15},"extension":{"x":960,"width":220,"y":-140,"height":79},"inputArgs":[{"bindValue":"5321989.summary_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"summary_text","require":false,"systemVariable":false}],"maxTokens":4096,"mode":"Balanced","modelId":299005,"outputArgs":[{"dataType":"String","enable":true,"key":"output","name":"description","require":false,"systemVariable":false}],"outputType":"JSON","skillComponentConfigs":[],"systemPrompt":"你是情绪问卷结果的事实描述助手。请根据给定的问卷计分结果，用不超过2句话向初中生描述事实。\n\n严格规则：\n- 只描述事实：共几题、总分、所处区间、区间说明\n- 不输出任何诊断结论（如焦虑症、抑郁症）\n- 不和常模比较，不说\"高于/低于同龄人\"\n- 不做正常/异常定性，不使用临床分级词\n- 不判断趋势、不预测未来\n- 语气平和友好，用初中生能听懂的话\n\n只输出以下JSON，不要输出任何其他内容：\n{\"description\": \"事实描述文本\"}\n\n","temperature":0.3,"topP":0.8,"userPrompt":"{{summary_text}}\n\n"},"preNodes":[],"spaceId":53260800,"type":"LLM","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257647},{"created":"2026-08-16 19:51:09","description":"作答不完整或格式无效，不计分不描述","id":5321992,"innerEndNode":false,"modified":"2026-08-16 19:51:44","name":"问卷失败输出","nextNodeIds":[5321993],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"问卷失败分支输出：作答不完整或格式无效时不计分\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(scoring_ok=False, error_message=\"\"):\n    if isinstance(scoring_ok, dict):\n        inputs = scoring_ok\n        scoring_ok = inputs.get(\"scoring_ok\", False)\n        error_message = inputs.get(\"error_message\", \"\")\n\n\n    error_message = str(scalar(error_message, \"\") or \"\")\n    if not error_message:\n        error_message = \"问卷作答不完整，无法计分\"\n\n    return {\n        \"scoring_ok\": False,\n        \"total_score\": 0,\n        \"range_label\": \"\",\n        \"range_desc\": \"\",\n        \"description\": \"\",\n        \"error_message\": error_message,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":960,"width":220,"y":30,"height":79},"inputArgs":[{"bindValue":"5321989.scoring_ok","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"scoring_ok","require":false,"systemVariable":false},{"bindValue":"5321989.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"scoring_ok","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"name":"total_score","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"range_label","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"range_desc","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"description","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257647},{"created":"2026-08-16 19:51:09","description":"归并计分成功分支与失败分支","id":5321993,"innerEndNode":false,"modified":"2026-08-20 21:34:32","name":"输出归并","nextNodeIds":[5321994],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"输出归并：归并问卷计分成功分支与失败分支\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(scoring_ok=False, total_score=0, range_label=\"\", range_desc=\"\",\n         summary_text=\"\", llm_description=\"\", fail_error_message=\"\"):\n    if isinstance(scoring_ok, dict):\n        inputs = scoring_ok\n        scoring_ok = inputs.get(\"scoring_ok\", False)\n        total_score = inputs.get(\"total_score\", 0)\n        range_label = inputs.get(\"range_label\", \"\")\n        range_desc = inputs.get(\"range_desc\", \"\")\n        summary_text = inputs.get(\"summary_text\", \"\")\n        llm_description = inputs.get(\"llm_description\", \"\")\n        fail_error_message = inputs.get(\"fail_error_message\", \"\")\n\n\n    scoring_ok = scalar(scoring_ok, False)\n    if isinstance(scoring_ok, str):\n        scoring_ok = scoring_ok.strip().lower() == \"true\"\n    try:\n        total_score = int(scalar(total_score, 0) or 0)\n    except (TypeError, ValueError):\n        total_score = 0\n    range_label = str(scalar(range_label, \"\") or \"\")\n    range_desc = str(scalar(range_desc, \"\") or \"\")\n    summary_text = str(scalar(summary_text, \"\") or \"\")\n    llm_description = str(scalar(llm_description, \"\") or \"\")\n    fail_error_message = str(scalar(fail_error_message, \"\") or \"\")\n\n    if scoring_ok:\n        return {\n            \"scoring_ok\": True,\n            \"total_score\": total_score,\n            \"range_label\": range_label,\n            \"range_desc\": range_desc,\n            \"description\": llm_description or summary_text,\n            \"error_message\": \"\",\n        }\n    return {\n        \"scoring_ok\": False,\n        \"total_score\": 0,\n        \"range_label\": \"\",\n        \"range_desc\": \"\",\n        \"description\": \"\",\n        \"error_message\": fail_error_message or \"问卷未完成\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":1280,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321989.scoring_ok","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"scoring_ok","require":false,"systemVariable":false},{"bindValue":"5321989.total_score","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"total_score","require":false,"systemVariable":false},{"bindValue":"5321989.range_label","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"range_label","require":false,"systemVariable":false},{"bindValue":"5321989.range_desc","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"range_desc","require":false,"systemVariable":false},{"bindValue":"5321989.summary_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"summary_text","require":false,"systemVariable":false},{"bindValue":"5321991.description","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"llm_description","re