TION_ID","enable":true,"key":"5f712efe-26c4-40d9-86bc-01e54f28fefd","name":"conversation_id","require":false,"systemVariable":false}],"modified":"2026-08-31 19:33:14","name":"危机安全门","nodes":[{"created":"2026-08-16 11:05:41","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321583,"innerEndNode":false,"modified":"2026-08-16 11:05:41","name":"开始","nextNodeIds":[5321584],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"当前用户消息","enable":true,"key":"7bdc43c4-d4ee-4af2-b9fc-1c22491de4dc","name":"user_text","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"41bf775e-b398-4887-a328-fbf03e8c629d","name":"owner_uid","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"会话标识，导入后建议在UI中改绑系统变量 CONVERSATION_ID","enable":true,"key":"5f712efe-26c4-40d9-86bc-01e54f28fefd","name":"conversation_id","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257587},{"created":"2026-08-16 11:05:41","description":"对用户消息做生命安全关键词扫描","id":5321584,"innerEndNode":false,"modified":"2026-08-16 11:05:47","name":"危机关键词检查","nextNodeIds":[5321585],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"危机关键词检查：对用户消息做生命安全关键词扫描\"\"\"\nimport re\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(user_text=\"\"):\n    if isinstance(user_text, dict):\n        inputs = user_text\n        user_text = inputs.get(\"user_text\", \"\")\n\n\n    normalized = str(scalar(user_text, \"\")).strip()\n\n    keywords = [\n        \"自杀\", \"轻生\", \"想死\", \"不想活\", \"活不下去\", \"寻死\",\n        \"结束生命\", \"了结自己\", \"想消失\", \"不配活着\",\n        \"自残\", \"自伤\", \"割腕\", \"割自己\", \"烧自己\", \"伤害自己\",\n        \"跳楼\", \"跳河\", \"跳下去\", \"从楼上\", \"吞药\", \"安眠药\",\n        \"吃药过量\", \"过量服药\", \"上吊\", \"烧炭\",\n        \"杀人\", \"伤害别人\", \"想伤害\", \"报复社会\", \"同归于尽\",\n    ]\n\n    keyword_match = any(kw in normalized for kw in keywords)\n\n    return {\n        \"keyword_match\": bool(keyword_match),\n        \"normalized\": normalized,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321583.user_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"user_text","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"keyword_match","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"normalized","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257587},{"created":"2026-08-16 11:05:41","description":"调用大模型判断消息是否含危机语义，超时走异常流程降级","id":5321585,"innerEndNode":false,"modified":"2026-08-22 14:13:16","name":"危机语义判断","nextNodeIds":[5321586],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[5321588],"exceptionHandleType":"EXECUTE_EXCEPTION_FLOW","retryCount":1,"specificContent":{},"timeout":8},"extension":{"x":620,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321583.user_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"user_text","require":false,"systemVariable":false}],"maxTokens":4096,"mode":"Precision","modelId":299005,"outputArgs":[{"dataType":"Boolean","enable":true,"key":"output","name":"crisis_detected","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"12184c21-662e-4e45-9970-2a060d662e6e","name":"signal_type","require":false,"systemVariable":false}],"outputType":"JSON","skillComponentConfigs":[],"systemPrompt":"你是生命安全信号检测助手。请判断用户消息是否包含以下任一信号：\n\n1. 明确表达轻生、自杀的想法或计划\n2. 正在实施的自伤行为\n3. 伤害他人的明确意图\n4. 正在发生的危险行为（如已服用过量药物、准备跳楼等）\n\n判断标准：\n- \"我很烦\"\"我不开心\"\"压力很大\"\"撑不住了\"不算安全信号\n- \"不想活了\"\"想结束这一切\"\"想消失\"\"不想存在了\"算安全信号\n- \"想打人\"\"很生气\"不算安全信号，\"想杀人\"\"要伤害某某\"算安全信号\n\n只输出以下JSON，不要输出任何其他内容：\n{\"crisis_detected\": true或false, \"signal_type\": \"信号类型描述，无则为空字符串\"}\n\n不输出风险等级，不分析原因，不提供建议，不输出原始文本，不输出markdown代码块标记。\n\n","temperature":0.1,"topP":0.7,"userPrompt":"{{user_text}}\n\n"},"preNodes":[],"spaceId":53260800,"type":"LLM","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257587},{"created":"2026-08-16 11:05:41","description":"关键词命中或大模型判定危机，任一成立即进入危机响应","id":5321586,"innerEndNode":false,"modified":"2026-08-16 11:06:19","name":"危机信号判断","nextNodeIds":[5321587,5321588],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5321584.keyword_match","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"keyword_match","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}},{"compareType":"EQUAL","firstArg":{"bindValue":"5321585.crisis_detected","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"crisis_detected","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"OR","nextNodeIds":[5321587],"uuid":"9d09368722d44e21ac7d66dae43544ee"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5321588],"uuid":"3006ecde7afd42968515516a71de8854"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":924,"width":300,"y":-220,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257587},{"created":"2026-08-16 11:05:41","description":"输出固定危机响应文本，不进入业务流程","id":5321587,"innerEndNode":false,"modified":"2026-08-31 19:33:13","name":"危机响应","nextNodeIds":[5321589],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"危机命中：生成固定危机响应，不进入任何业务流程\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(crisis_signal_detected=False):\n    if isinstance(crisis_signal_detected, dict):\n        crisis_signal_detected = crisis_signal_detected.get(\"crisis_signal_detected\", False)\n\n\n    return {\n        \"crisis_signal_detected\": True,\n        \"crisis_response\": \"我听到了你说的，你现在一定很难。\\n\\n请先保证自己的安全：远离可能伤害到你的物品和场所。\\n\\n如果你正处于危险中，请立刻拨打：\\n- 紧急求助：110\\n- 心理援助热线：400-161-9995（全国24小时）\\n\\n也可以马上告诉身边你信任的成年人、监护人或学校老师。你不必一个人面对这些。\",\n        \"degradation_note\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1290,"width":220,"y":-109,"height":79},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"crisis_response","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"degradation_note","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257587},{"created":"2026-08-16 11:05:41","description":"未命中危机信号；语义判断超时时经异常流程直接进入本节点","id":5321588,"innerEndNode":false,"modified":"2026-08-31 19:33:13","name":"安全放行","nextNodeIds":[5321589],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"安全放行：未命中危机信号；语义判断超时会经异常流程直接进入本节点\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(keyword_match=False, crisis_detected=False):\n    if isinstance(keyword_match, dict):\n        inputs = keyword_match\n        keyword_match = inputs.get(\"keyword_match\", False)\n        crisis_detected = inputs.get(\"crisis_detected\", False)\n\n\n    keyword_match = scalar(keyword_match, False)\n    if isinstance(keyword_match, str):\n        keyword_match = keyword_match.strip().lower() == \"true\"\n    crisis_detected = scalar(crisis_detected, None)\n    if crisis_detected is None:\n        degraded = True\n        crisis_detected = False\n    else:\n        degraded = False\n        if isinstance(crisis_detected, str):\n            crisis_detected = crisis_detected.strip().lower() == \"true\"\n\n    note = \"\"\n    if degraded:\n        note = \"危机语义判断未返回结果，本次仅完成关键词检查。\"\n\n    return {\n        \"crisis_signal_detected\": False,\n        \"crisis_response\": \"\",\n        \"degradation_note\": note,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1290,"width":220,"y":14,"height":79},"inputArgs":[{"bindValue":"5321584.keyword_match","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"keyword_match","require":false,"systemVariable":false},{"bindValue":"5321585.crisis_detected","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"crisis_detected","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"crisis_response","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"degradation_note","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257587},{"created":"2026-08-16 11:05:41","description":"归并危机命中分支与安全放行分支的输出","id":5321589,"innerEndNode":false,"modified":"2026-08-16 11:05:47","name":"最终输出整理","nextNodeIds":[5321590],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"最终输出整理：归并危机命中分支与安全放行分支\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(hit_detected=False, hit_response=\"\", pass_detected=False,\n         pass_response=\"\", pass_note=\"\"):\n    if isinstance(hit_detected, dict):\n        inputs = hit_detected\n        hit_detected = inputs.get(\"hit_detected\", False)\n        hit_response = inputs.get(\"hit_response\", \"\")\n        pass_detected = inputs.get(\"pass_detected\", False)\n        pass_response = inputs.get(\"pass_response\", \"\")\n        pass_note = inputs.get(\"pass_note\", \"\")\n\n\n    hit_detected = scalar(hit_detected, False)\n    hit_response = scalar(hit_response, \"\")\n    pass_detected = scalar(pass_detected, False)\n    pass_response = scalar(pass_response, \"\")\n    pass_note = scalar(pass_note, \"\")\n\n    if hit_detected:\n        return {\n            \"crisis_signal_detected\": True,\n            \"crisis_response\": hit_response,\n            \"degradation_note\": \"\",\n        }\n    return {\n        \"crisis_signal_detected\": False,\n        \"crisis_response\": pass_response,\n        \"degradation_note\": pass_note,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1620,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321587.crisis_signal_detected","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"hit_detected","require":false,"systemVariable":false},{"bindValue":"5321587.crisis_response","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"hit_response","require":false,"systemVariable":false},{"bindValue":"5321588.crisis_signal_detected","bindValueType":"Reference","d