{"name":"学业任务状态更新","templateConfig":{"category":"FinanceAndCommerce","created":"2026-08-16 19:43:11","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"校验学习任务状态转换合法性（pending→active；active/paused→paused或completed），并生成限定当前用户的更新参数","endNode":{"created":"2026-08-16 19:43:11","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5321958,"innerEndNode":false,"modified":"2026-08-16 19:43:11","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1600,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5321957.update_ready","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"update_ready","require":false,"systemVariable":false},{"bindValue":"5321957.update_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"update_sql","require":false,"systemVariable":false},{"bindValue":"5321957.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257641},"icon":"https://agent.nuwax.com/api/f/s3/workflow/20260816/611d6b60f61048bea36573a1a4ab1a44.png","id":5257641,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"任务记录ID（数据表自增主键 id）","enable":true,"key":"3469ffb4-179c-40eb-b788-d7e142c1714e","name":"task_id","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"任务当前状态 pending/active/paused/completed","enable":true,"key":"fcd153b3-72e5-4712-a18e-6c299d8a7dfa","name":"current_status","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"目标状态 pending/active/paused/completed","enable":true,"key":"9ef7da78-4032-4a80-b887-933b765b4ac0","name":"new_status","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"暂停原因，暂停时必填","enable":true,"key":"6abc66c8-87a1-4b1a-992d-6d9803d1a214","name":"pause_reason","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"417e98f6-f793-45ce-ae61-9bbe4f663d40","name":"owner_uid","require":false,"systemVariable":false}],"modified":"2026-08-22 14:17:40","name":"学业任务状态更新","nodes":[{"created":"2026-08-16 19:43:11","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321952,"innerEndNode":false,"modified":"2026-08-16 19:43:11","name":"开始","nextNodeIds":[5321953],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"任务记录ID（数据表自增主键 id）","enable":true,"key":"3469ffb4-179c-40eb-b788-d7e142c1714e","name":"task_id","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"任务当前状态 pending/active/paused/completed","enable":true,"key":"fcd153b3-72e5-4712-a18e-6c299d8a7dfa","name":"current_status","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"目标状态 pending/active/paused/completed","enable":true,"key":"9ef7da78-4032-4a80-b887-933b765b4ac0","name":"new_status","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"暂停原因，暂停时必填","enable":true,"key":"6abc66c8-87a1-4b1a-992d-6d9803d1a214","name":"pause_reason","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"417e98f6-f793-45ce-ae61-9bbe4f663d40","name":"owner_uid","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257641},{"created":"2026-08-16 19:43:11","description":"校验状态转换合法性与暂停原因","id":5321953,"innerEndNode":false,"modified":"2026-08-16 19:43:15","name":"状态校验","nextNodeIds":[5321954],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"学业任务状态转换合法性校验（合法路径 pending→active；active→paused/completed；paused→active/completed）\"\"\"\n\nVALID_TRANSITIONS = {\n    \"pending\": [\"active\"],\n    \"active\": [\"paused\", \"completed\"],\n    \"paused\": [\"active\", \"completed\"],\n    \"completed\": [],\n}\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(current_status=\"\", new_status=\"\", pause_reason=\"\"):\n    if isinstance(current_status, dict):\n        inputs = current_status\n        current_status = inputs.get(\"current_status\", \"\")\n        new_status = inputs.get(\"new_status\", \"\")\n        pause_reason = inputs.get(\"pause_reason\", \"\")\n\n\n    current_status = str(scalar(current_status, \"\") or \"\").strip()\n    new_status = str(scalar(new_status, \"\") or \"\").strip()\n    pause_reason = str(scalar(pause_reason, \"\") or \"\").strip()\n\n    if not current_status:\n        return _fail(\"无法获取当前任务状态\")\n    if not new_status:\n        return _fail(\"目标状态不能为空\")\n    if new_status == \"paused\" and not pause_reason:\n        return _fail(\"暂停任务必须填写暂停原因\")\n\n    if current_status not in VALID_TRANSITIONS:\n        return _fail('当前状态\"%s\"不是合法状态' % current_status)\n\n    allowed = VALID_TRANSITIONS[current_status]\n    if new_status not in allowed:\n        if current_status == \"completed\":\n            return _fail(\"已完成的任务不能再次更改状态\")\n        return _fail('不允许从\"%s\"转换到\"%s\"' % (current_status, new_status))\n\n    return {\n        \"validation_passed\": True,\n        \"error_message\": \"\",\n    }\n\n\ndef _fail(msg):\n    return {\n        \"validation_passed\": False,\n        \"error_message\": msg,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321952.current_status","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"current_status","require":false,"systemVariable":false},{"bindValue":"5321952.new_status","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"new_status","require":false,"systemVariable":false},{"bindValue":"5321952.pause_reason","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"pause_reason","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257641},{"created":"2026-08-16 19:43:11","description":"校验通过才生成更新参数","id":5321954,"innerEndNode":false,"modified":"2026-08-16 19:43:11","name":"校验判断","nextNodeIds":[5321955,5321956],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5321953.validation_passed","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"validation_passed","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5321955],"uuid":"535cf194034e44ce9d27b56a42c66ceb"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5321956],"uuid":"63aff780af7d4cbcbf2cce7cdba55dcd"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":640,"width":300,"y":-60,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257641},{"created":"2026-08-16 19:43:11","description":"生成更新字段与更新SQL（限当前用户）；导入后可在UI中改用数据更新节点直接执行","id":5321955,"innerEndNode":false,"modified":"2026-08-16 19:43:15","name":"生成更新参数","nextNodeIds":[5321957],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"生成 study_tasks 更新参数与更新 SQL（WHERE 同时限定任务 id 与用户 uid，禁止跨用户修改）\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(task_id=0, new_status=\"\", pause_reason=\"\"):\n    if isinstance(task_id, dict):\n        inputs = task_id\n        task_id = inputs.get(\"task_id\", 0)\n        new_status = inputs.get(\"new_status\", \"\")\n        pause_reason = inputs.get(\"pause_reason\", \"\")\n\n\n    new_status = str(scalar(new_status, \"\") or \"\").strip()\n    pause_reason = str(scalar(pause_reason, \"\") or \"\").strip()\n\n    set_clause = \"status = '%s'\" % new_status\n    if new_status == \"paused\" and pause_reason:\n        set_clause += \", pause_reason = '%s'\" % pause_reason.replace(\"'\", \"''\")\n    else:\n        set_clause += \", pause_reason = ''\"\n\n    update_sql = \"UPDATE study_tasks SET %s WHERE id = %s\" % (\n        set_clause, scalar(task_id, 0) or 0)\n\n    return {\n        \"update_ready\": True,\n        \"update_sql\": update_sql,\n        \"error_message\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1034,"width":220,"y":-154,"height":79},"inputArgs":[{"bindValue":"5321952.task_id","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"task_id","require":false,"systemVariable":false},{"bindValue":"5321952.new_status","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"new_status","require":false,"systemVariable":false},{"bindValue":"5321952.pause_reason","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"pause_reason","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"update_ready","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"update_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257641},{"created":"2026-08-16 19:43:11","description":"状态校验未通过","id":5321956,"innerEndNode":false,"modified":"2026-08-16 19:43:15","name":"更新失败输出","nextNodeIds":[5321957],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"状态更新失败分支输出\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(validation_passed=False, error_message=\"\"):\n    if isinstance(validation_passed, dict):\n        inputs = validation_passed\n        validation_passed = inputs.get(\"validation_passed\", False)\n        error_message = inputs.get(\"error_message\", \"\")\n\n\n    error_message = str(scalar(error_message, \"\") or \"\")\n    if not error_message:\n        error_message = \"状态转换校验未通过\"\n\n    return {\n        \"update_ready\": False,\n        \"update_sql\": \"\",\n        \"error_message\": error_message,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1012,"width":220,"y":22,"height":79},"inputArgs":[{"bindValue":"5321953.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5321953.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"update_ready","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"update_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257641},{"created":"2026-08-16 19:43:11","description":"归并更新就绪分支与失败分支","id":5321957,"innerEndNode":false,"modified":"2026-08-16 19:43:15","name":"输出归并","nextNodeIds":[5321958],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"输出归并：归并更新就绪分支与失败分支\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(ok_update_ready=False, ok_update_sql=\"\", fail_update_ready=False,\n         fail_error_message=\"\"):\n    if isinstance(ok_update_ready, dict):\n        inputs = ok_update_ready\n        ok_update_ready = inputs.get(\"ok_update_ready\", False)\n        ok_update_sql = inputs.get(\"ok_update_sql\", \"\")\n        fail_update_ready = inputs.get(\"fail_update_ready\", False)\n        fail_error_message = inputs.get(\"fail_error_message\", \"\")\n\n\n    ok_update_ready = scalar(ok_update_ready, False)\n    ok_update_sql = str(scalar(ok_update_sql, \"\") or \"\")\n    fail_error_message = str(scalar(fail_error_message, \"\") or \"\")\n\n    if ok_update_ready:\n        return {\n            \"update_ready\": True,\n            \"update_sql\": ok_update_sql,\n            \"error_message\": \"\",\n        }\n    return {\n        \"update_ready\": False,\n        \"update_sql\": \"\",\n        \"error_message\": fail_error_message or \"状态更新未执行\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1290,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321955.update_ready","bindValueType":"Reference","dataType":"Boolean",