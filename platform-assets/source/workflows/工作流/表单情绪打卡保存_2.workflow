7-42ed-acb7-d1d1fba3fe1f","name":"emotion_name","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"情绪强度 1-5","enable":true,"key":"67b3b4f3-edbb-48b8-a396-54b4d03801b2","name":"intensity","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"触发原因简述","enable":true,"key":"9f1335a5-1df7-4de3-a2d1-b4c191e6a8bb","name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"知情同意状态 accepted/declined","enable":true,"key":"f0d3ddfe-e57f-4e11-ace2-11795129d852","name":"psych_consent","require":true,"systemVariable":false}],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 00:53:19","description":"校验输入有效性并准备 mood_log 写入数据","id":5322120,"innerEndNode":false,"modified":"2026-08-17 00:53:19","name":"校验与数据准备","nextNodeIds":[5322121],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// JS 模板（未使用）\nexport default async function main(args) {\n    return { key: \"value\" };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"\n工作流: 表单情绪打卡保存\n节点: 校验与数据准备\n输入: emotion_name (String), intensity (Integer), trigger_summary (String), psych_consent (String)\n输出: valid (Boolean), error_msg (String), mood_type (String), intensity_self (Integer),\n      trigger_event (String), duration_hours (Number), impact_study (String),\n      impact_life (String), raw_text (String), confidence (Number), expires_at (String)\n\"\"\"\n\ndef main(emotion_name=\"\", intensity=0, trigger_summary=\"\", psych_consent=\"\"):\n    # 兼容字典传参（平台可能把所有输入打包为字典传给第一个参数）\n    if isinstance(emotion_name, dict):\n        inputs = emotion_name\n        emotion_name = inputs.get(\"emotion_name\", \"\")\n        intensity = inputs.get(\"intensity\", 0)\n        trigger_summary = inputs.get(\"trigger_summary\", \"\")\n        psych_consent = inputs.get(\"psych_consent\", \"\")\n\n    # ---- 校验逻辑 ----\n    consent_ok = psych_consent == \"accepted\"\n    name_ok = bool((emotion_name or \"\").strip())\n\n    try:\n        intensity_val = int(intensity or 0)\n    except (ValueError, TypeError):\n        intensity_val = 0\n    intensity_ok = 1 <= intensity_val <= 5\n\n    valid = consent_ok and name_ok and intensity_ok\n\n    # ---- 错误信息 ----\n    error_msg = \"\"\n    if not consent_ok:\n        error_msg = \"未通过知情同意校验\"\n    elif not name_ok:\n        error_msg = \"情绪名称不能为空\"\n    elif not intensity_ok:\n        error_msg = \"强度必须在 1-5 之间\"\n\n    # ---- 准备写入数据 ----\n    mood_type = (emotion_name or \"\").strip()\n    trigger_event = (trigger_summary or \"\").strip() or \"未填写\"\n\n    raw_text = f\"情绪打卡: {mood_type}, 强度: {intensity_val}/5\"\n    if trigger_event != \"未填写\":\n        raw_text += f\", 触发原因: {trigger_event}\"\n\n    # ---- 计算过期时间 (7天后, UTC ISO8601) ----\n    from datetime import datetime, timezone, timedelta\n    expires_dt = datetime.now(timezone.utc) + timedelta(days=7)\n    expires_at = expires_dt.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    return {\n        \"valid\": valid,\n        \"error_msg\": error_msg,\n        \"mood_type\": mood_type,\n        \"intensity_self\": intensity_val,\n        \"trigger_event\": trigger_event,\n        \"expires_at\": expires_at,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":300,"width":220,"y":-88,"height":79},"inputArgs":[{"bindValue":"5322119.emotion_name","bindValueType":"Reference","dataType":"String","enable":true,"name":"emotion_name","require":false,"systemVariable":false},{"bindValue":"5322119.intensity","bindValueType":"Reference","dataType":"Integer","enable":true,"name":"intensity","require":false,"systemVariable":false},{"bindValue":"5322119.trigger_summary","bindValueType":"Reference","dataType":"String","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5322119.psych_consent","bindValueType":"Reference","dataType":"String","enable":true,"name":"psych_consent","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"key":"3f32a29c-e42c-4d6d-8dd7-adc5bee6dc03","name":"valid","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"273eaa92-f5c1-4aa2-a24c-2bc593708fbb","name":"error_msg","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"5ddb2350-a6db-4e61-b9df-5a5c016bb4f3","name":"mood_type","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"key":"0fb85f85-4e9e-40ad-a285-fa5a33ea88e8","name":"intensity_self","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"62b0902c-6b2a-4ae5-89f2-fa201c20d6f1","name":"trigger_event","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"a250505e-ac99-4fd1-872e-77135c0d8bfd","name":"expires_at","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 00:53:19","description":"校验通过则写入 mood_log，否则返回错误","id":5322121,"innerEndNode":false,"modified":"2026-08-17 00:53:57","name":"条件分支","nextNodeIds":[5322125,5322124],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5322120.valid","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"valid","require":fa