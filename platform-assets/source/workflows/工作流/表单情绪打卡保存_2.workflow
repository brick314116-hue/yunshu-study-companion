{"name":"表单情绪打卡保存_2","templateConfig":{"category":"FinanceAndCommerce","created":"2026-08-17 00:53:19","creator":{"nickName":"板砖","userId":1785295571,"userName":"brick314116"},"creatorId":1785295571,"description":"接收表单提交的情绪打卡数据，校验后写入 mood_checkin 数据表。通过 API POST /api/v1/workflow/{id}/execute 调用。","endNode":{"created":"2026-08-17 00:53:19","description":"返回打卡结果","id":5322118,"innerEndNode":false,"modified":"2026-08-17 00:53:19","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1550,"width":220,"y":-30,"height":44},"inputArgs":[],"outputArgs":[{"bindValue":"5322123.success","bindValueType":"Reference","dataType":"String","description":"是否成功","enable":true,"name":"success","require":false,"systemVariable":false},{"bindValue":"5322123.record_id","bindValueType":"Reference","dataType":"String","description":"新增记录 ID","enable":true,"name":"record_id","require":false,"systemVariable":false},{"bindValue":"5322124.error_msg","bindValueType":"Reference","dataType":"String","description":"错误信息（成功时为空）","enable":true,"name":"error_msg","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},"icon":"https://agent.nuwax.com/api/f/s3/icon/20260817/default.svg","id":5257662,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"情绪名称（如焦虑、低落、平静等）","enable":true,"key":"01ef38ea-50e7-42ed-acb7-d1d1fba3fe1f","name":"emotion_name","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"情绪强度 1-5","enable":true,"key":"67b3b4f3-edbb-48b8-a396-54b4d03801b2","name":"intensity","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"触发原因简述","enable":true,"key":