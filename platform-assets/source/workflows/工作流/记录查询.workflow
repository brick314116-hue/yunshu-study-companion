n        \"query_ready\": True,\n        \"query_sql\": str(scalar(query_sql, \"\") or \"\"),\n        \"current_time\": str(scalar(current_time, \"\") or \"\"),\n        \"error_message\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":960,"width":220,"y":-139,"height":79},"inputArgs":[{"bindValue":"5321979.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5321979.query_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"5321979.current_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"current_time","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"query_ready","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"current_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257645},{"created":"2026-08-16 19:49:48","description":"查询校验未通过","id":5321982,"innerEndNode":false,"modified":"2026-08-16 19:50:19","name":"查询失败输出","nextNodeIds":[5321983],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"查询失败分支输出\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(validation_passed=False, error_message=\"\"):\n    if isinstance(validation_passed, dict):\n        inputs = validation_passed\n        validation_passed = inputs.get(\"validation_passed\", False)\n        error_message = inputs.get(\"error_message\", \"\")\n\n\n    error_message = str(scalar(error_message, \"\") or \"\")\n    if not error_message:\n        error_message = \"查询校验未通过\"\n\n    return {\n        \"query_ready\": False,\n        \"query_sql\": \"\",\n        \"current_time\": \"\",\n        \"error_message\": error_message,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":960,"width":220,"y":30,"height":79},"inputArgs":[{"bindValue":"5321979.validation_passed","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"5321979.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"query_ready","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"current_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257645},{"created":"2026-08-16 19:49:48","description":"归并查询就绪分支与失败分支","id":5321983,"innerEndNode":false,"modified":"2026-08-20 21:35:37","name":"输出归并","nextNodeIds":[5321984],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"输出归并：归并查询就绪分支与失败分支\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(ok_query_ready=False, ok_query_sql=\"\", ok_current_time=\"\",\n         fail_error_message=\"\"):\n    if isinstance(ok_query_ready, dict):\n        inputs = ok_query_ready\n        ok_query_ready = inputs.get(\"ok_query_ready\", False)\n        ok_query_sql = inputs.get(\"ok_query_sql\", \"\")\n        ok_current_time = inputs.get(\"ok_current_time\", \"\")\n        fail_error_message = inputs.get(\"fail_error_message\", \"\")\n\n\n    ok_query_ready = scalar(ok_query_ready, False)\n    fail_error_message = str(scalar(fail_error_message, \"\") or \"\")\n\n    if ok_query_ready:\n        return {\n            \"query_ready\": True,\n            \"query_sql\": str(scalar(ok_query_sql, \"\") or \"\"),\n            \"current_time\": str(scalar(ok_current_time, \"\") or \"\"),\n            \"error_message\": \"\",\n        }\n    return {\n        \"query_ready\": False,\n        \"query_sql\": \"\",\n        \"current_time\": \"\",\n        \"error_message\": fail_error_message or \"查询未执行\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":