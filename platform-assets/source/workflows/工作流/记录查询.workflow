{"name":"记录查询","templateConfig":{"category":"FinanceAndCommerce","created":"2026-08-16 19:49:48","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"按查询类型生成当前用户未过期记录的查询SQL（uid限定当前用户、过滤过期记录、按创建时间倒序）","endNode":{"created":"2026-08-16 19:49:48","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5321984,"innerEndNode":false,"modified":"2026-08-16 19:49:48","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1590,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5321983.query_ready","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"query_ready","require":false,"systemVariable":false},{"bindValue":"5321983.query_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"5321983.current_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"current_time","require":false,"systemVariable":false},{"bindValue":"5321983.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257645},"icon":"https://agent.nuwax.com/api/f/s3/workflow/20260816/213c3272e94e4821a98726bcd0e10c4d.png","id":5257645,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"查询类型：mood/study_task/cognitive_practice","enable":true,"key":"93b1a3ef-5659-4066-88ca-0947363e087f","name":"query_type","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"b3ca3769-b354-4a48-a7d9-a9e7f0f8ee8e","name":"owner_uid","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"返回条数上限，默认10，最大50","enable":true,"key":"b3e4152c-5262-4681-ba01-88559a1d38eb","name":"limit","require":false,"systemVariable":false}],"modified":"2026-08-22 18:39:45","name":"记录查询","nodes":[{"created":"2026-08-16 19:49:48","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321978,"innerEndNode":false,"modified":"2026-08-16 19:49:48","name":"开始","nextNodeIds":[5321979],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"查询类型：mood/study_task/cognitive_practice","enable":true,"key":"93b1a3ef-5659-4066-88ca-0947363e087f","name":"query_type","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"b3ca3769-b354-4a48-a7d9-a9e7f0f8ee8e","name":"owner_uid","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"返回条数上限，默认10，最大50","enable":true,"key":"b3e4152c-5262-4681-ba01-88559a1d38eb","name":"limit","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257645},{"created":"2026-08-16 19:49:48","description":"校验查询类型并生成限定当前用户、过滤过期记录的查询SQL","id":5321979,"innerEndNode":false,"modified":"2026-08-16 19:50:19","name":"查询SQL生成","nextNodeIds":[5321980],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"记录查询类型校验与查询 SQL 生成（按系统 uid 字段限定当前用户，过滤过期记录）\"\"\"\nfrom datetime import datetime\n\nTABLE_MAP = {\n    \"mood\": \"mood_log\",\n    \"study_task\": \"study_tasks\",\n    \"cognitive_practice\": \"cognitive_practice\",\n}\n\nFIELDS_MAP = {\n    \"mood_log\": \"id, mood_type, intensity_self, duration_hours, \"\n                \"trigger_summary, impact_study, impact_life, expires_at, created\",\n    \"study_tasks\": \"id, goal, steps, status, pause_reason, expires_at, created\",\n    \"cognitive_practice\": \"id, event_summary, thought_summary, \"\n                          \"emotion_name, evidence_summary, \"\n                          \"alternative_explanation, expires_at, created\",\n}\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(query_type=\"\", owner_uid=\"\", limit=10):\n    if isinstance(query_type, dict):\n        inputs = query_type\n        query_type = inputs.get(\"query_type\", \"\")\n        owner_uid = inputs.get(\"owner_uid\", \"\")\n        limit = inputs.get(\"limit\", 10)\n\n\n    query_type = str(scalar(query_type, \"\") or \"\").strip()\n    owner_uid = str(scalar(owner_uid, \"\") or \"\").strip()\n\n    if not owner_uid:\n        return _fail(\"缺少用户标识\")\n    if query_type not in TABLE_MAP:\n        return _fail(\"查询类型非法，可选：mood、study_task、cognitive_practice\")\n\n    table = TABLE_MAP[query_type]\n    fields = FIELDS_MAP[table]\n    current_time = datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    safe_uid = owner_uid.replace(\"'\", \"''\")\n\n    try:\n        limit_val = int(scalar(limit, 10) or 10)\n    except (TypeError, ValueError):\n        limit_val = 10\n    if limit_val < 1:\n        limit_val = 10\n    if limit_val > 50:\n        limit_val = 50\n\n    query_sql = (\n        \"SELECT %s FROM %s \"\n        \"WHERE uid = '%s' \"\n        \"AND expires_at > '%s' \"\n        \"ORDER BY created DESC \"\n        \"LIMIT %s\" % (fields, table, safe_uid, current_time, limit_val)\n    )\n\n    return {\n        \"validation_passed\": True,\n        \"error_message\": \"\",\n        \"query_sql\": query_sql,\n        \"current_time\": current_time,\n    }\n\n\ndef _fail(msg):\n    return {\n        \"validation_passed\": False,\n        \"error_message\": msg,\n        \"query_sql\": \"\",\n        \"current_time\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321978.query_type","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"query_type","require":false,"systemVariable":false},{"bindValue":"5321978.owner_uid","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"owner_uid","require":false,"systemVariable":false},{"bindValue":"5321978.limit","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"limit","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"validation_passed","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"current_time","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257645},{"created":"2026-08-16 19:49:48","description":"校验通过才输出查询SQL","id":5321980,"innerEndNode":false,"modified":"2026-08-16 19:49:48","name":"校验判断","nextNodeIds":[5321981,5321982],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5321979.validation_passed","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"validation_passed","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5321981],"uuid":"4cc176a819d14515859e1bbd902922e0"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5321982],"uuid":"c9e043558df94eb4b4fc00bd9ce0e80f"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":640,"width":300,"y":-60,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreac