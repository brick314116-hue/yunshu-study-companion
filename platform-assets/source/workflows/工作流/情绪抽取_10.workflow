{"name":"情绪抽取_10","templateConfig":{"category":"FinanceAndCommerce","created":"2026-08-16 11:20:06","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"从用户消息生成待确认的结构化情绪草稿：先过危机检查，再结构化提取并按置信度生成草稿或追问，不写数据表","endNode":{"created":"2026-08-16 11:20:06","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5321608,"innerEndNode":false,"modified":"2026-08-16 11:20:06","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":2210,"width":220,"y":-60,"height":44},"outputArgs":[{"bindValue":"5321607.crisis_signal_detected","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false},{"bindValue":"5321607.crisis_response","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"crisis_response","require":false,"systemVariable":false},{"bindValue":"5321607.has_emotion","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"has_emotion","require":false,"systemVariable":false},{"bindValue":"5321607.mood_type","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"mood_type","require":false,"systemVariable":false},{"bindValue":"5321607.intensity_candidate","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"intensity_candidate","require":false,"systemVariable":false},{"bindValue":"5321607.duration_hours","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"5321607.trigger_summary","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5321607.impact_study","bindValueType":"Referen