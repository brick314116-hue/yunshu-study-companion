d6c88-6afd-4661-9535-55e93f93186e","name":"conversation_id","require":false,"systemVariable":false}],"modified":"2026-08-22 14:16:44","name":"情绪抽取_10","nodes":[{"created":"2026-08-16 11:20:06","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321600,"innerEndNode":false,"modified":"2026-08-16 11:20:06","name":"开始","nextNodeIds":[5321601],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"当前用户消息","enable":true,"key":"1175b65d-9dd6-43f0-be85-f3be80b74b2f","name":"user_text","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"8189b9e4-7ca1-42e3-978e-30334af60b8a","name":"owner_uid","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"会话标识，导入后建议在UI中改绑系统变量 CONVERSATION_ID","enable":true,"key":"927d6c88-6afd-4661-9535-55e93f93186e","name":"conversation_id","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"对用户消息做生命安全关键词扫描","id":5321601,"innerEndNode":false,"modified":"2026-08-16 11:24:26","name":"危机关键词检查","nextNodeIds":[5321602],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"危机关键词检查：对用户消息做生命安全关键词扫描\"\"\"\nimport re\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(user_text=\"\"):\n    if isinstance(user_text, dict):\n        inputs = user_text\n        user_text = inputs.get(\"user_text\", \"\")\n\n\n    normalized = str(scalar(user_text, \"\")).strip()\n\n    keywords = [\n        \"自杀\", \"轻生\", \"想死\", \"不想活\", \"活不下去\", \"寻死\",\n        \"结束生命\", \"了结自己\", \"想消失\", \"不配活着\",\n        \"自残\", \"自伤\", \"割腕\", \"割自己\", \"烧自己\", \"伤害自己\",\n        \"跳楼\", \"跳河\", \"跳下去\", \"从楼上\", \"吞药\", \"安眠药\",\n        \"吃药过量\", \"过量服药\", \"上吊\", \"烧炭\",\n        \"杀人\", \"伤害别人\", \"想伤害\", \"报复社会\", \"同归于尽\",\n    ]\n\n    keyword_match = any(kw in normalized for kw in keywords)\n\n    return {\n        \"keyword_match\": bool(keyword_match),\n        \"normalized\": normalized,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":300,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321600.user_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"user_text","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"keyword_match","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"normalized","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"判断消息是否含危机语义，超时走异常流程降级继续情绪提取","id":5321602,"innerEndNode":false,"modified":"2026-08-16 11:20:06","name":"危机语义判断","nextNodeIds":[5321603],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[5321605],"exceptionHandleType":"EXECUTE_EXCEPTION_FLOW","retryCount":1,"specificContent":{},"timeout":8},"extension":{"x":580,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321600.user_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"user_text","require":false,"systemVariable":false}],"maxTokens":4096,"mode":"Precision","modelId":294558,"outputArgs":[{"dataType":"Boolean","enable":true,"key":"output","name":"crisis_detected","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"6013fb19-3bb8-41fe-8c8d-5113e5d459bb","name":"signal_type","require":false,"systemVariable":false}],"outputType":"JSON","skillComponentConfigs":[],"systemPrompt":"你是生命安全信号检测助手。请判断用户消息是否包含以下任一信号：\n\n1. 明确表达轻生、自杀的想法或计划\n2. 正在实施的自伤行为\n3. 伤害他人的明确意图\n4. 正在发生的危险行为（如已服用过量药物、准备跳楼等）\n\n判断标准：\n- \"我很烦\"\"我不开心\"\"压力很大\"\"撑不住了\"不算安全信号\n- \"不想活了\"\"想结束这一切\"\"想消失\"\"不想存在了\"算安全信号\n- \"想打人\"\"很生气\"不算安全信号，\"想杀人\"\"要伤害某某\"算安全信号\n\n只输出以下JSON，不要输出任何其他内容：\n{\"crisis_detected\": true或false, \"signal_type\": \"信号类型描述，无则为空字符串\"}\n\n不输出风险等级，不分析原因，不提供建议，不输出原始文本，不输出markdown代码块标记。","temperature":0.1,"topP":0.7,"userPrompt":"{{user_text}}\n\n"},"preNodes":[],"spaceId":53260800,"type":"LLM","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"命中危机信号则拦截，不进行情绪抽取","id":5321603,"innerEndNode":false,"modified":"2026-08-16 11:24:26","name":"危机信号判断","nextNodeIds":[5321605,5321604],"nextNodes":[],"nodeConfig":{"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5321601.keyword_match","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"keyword_match","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}},{"compareType":"EQUAL","firstArg":{"bindValue":"5321602.crisis_detected","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"crisis_detected","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"Boolean","enable":true,"require":false,"systemVariable":false}}],"conditionType":"OR","nextNodeIds":[5321604],"uuid":"48de3ecb952e4a61962b7e8c090d8a80"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5321605],"uuid":"fc6b1a05005d47b0b62ee75130ae3052"}],"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":890,"width":300,"y":-60,"height":119},"inputArgs":[],"outputArgs":[]},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"返回固定危机响应，情绪字段全部置空","id":5321604,"innerEndNode":false,"modified":"2026-08-16 11:24:26","name":"危机拦截输出","nextNodeIds":[5321607],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"危机拦截：检测到危机信号时不做情绪抽取，直接返回固定危机响应\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(keyword_match=False, crisis_detected=False):\n    if isinstance(keyword_match, dict):\n        inputs = keyword_match\n        keyword_match = inputs.get(\"keyword_match\", False)\n        crisis_detected = inputs.get(\"crisis_detected\", False)\n\n\n    return {\n        \"crisis_signal_detected\": True,\n        \"crisis_response\": \"我听到了你说的，你现在一定很难。\\n\\n请先保证自己的安全：远离可能伤害到你的物品和场所。\\n\\n如果你正处于危险中，请立刻拨打：\\n- 紧急求助：110\\n- 心理援助热线：400-161-9995（全国24小时）\\n\\n也可以马上告诉身边你信任的成年人、监护人或学校老师。你不必一个人面对这些。\",\n        \"has_emotion\": False,\n        \"mood_type\": \"\",\n        \"intensity_candidate\": 0,\n        \"duration_hours\": \"\",\n        \"trigger_summary\": \"\",\n        \"impact_study\": \"\",\n        \"impact_life\": \"\",\n        \"confidence\": 0.0,\n        \"show_draft\": False,\n        \"need_followup\": False,\n        \"draft_text\": \"\",\n        \"followup_text\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1230,"width":220,"y":-180,"height":79},"inputArgs":[{"bindValue":"5321601.keyword_match","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"keyword_match","require":false,"systemVariable":false},{"bindValue":"5321602.crisis_detected","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"crisis_detected","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"crisis_response","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"has_emotion","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"mood_type","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"name":"intensity_candidate","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"impact_study","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"impact_life","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"name":"confidence","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"show_draft","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"need_followup","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"draft_text","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"followup_text","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"从用户消息提取结构化情绪信息，输出纯JSON","id":5321605,"innerEndNode":false,"modified":"2026-08-16 11:20:06","name":"情绪结构化提取","nextNodeIds":[5321606],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":1,"specificContent":{},"timeout":15},"extension":{"x":1230,"width":220,"y":40,"height":79},"inputArgs":[{"bindValue":"5321600.user_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"user_text","require":false,"systemVariable":false}],"maxTokens":4096,"mode":"Balanced","modelId":294558,"outputArgs":[{"dataType":"Boolean","enable":true,"key":"output","name":"has_emotion","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"d592c835-168f-4842-85e8-d966d807b60a","name":"mood_type","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"key":"0cbe1725-b944-48b6-a788-eda32b18ac30","name":"intensity_candidate","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"key":"29ca043d-c2fe-4782-82b0-45afda7752d5","name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"d74d94b6-562f-4ae9-a90e-33bba98f13b4","name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"2317eaeb-01db-4452-af43-b7eb723aa559","name":"impact_study","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"aadf376a-8de2-423e-b4fc-b6e0d0cd2fb3","name":"impact_life","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"key":"9814aea3-5e10-4947-b760-55faa0b4a94d","name":"confidence","require":false,"systemVariable":false}],"outputType":"JSON","skillComponentConfigs":[],"systemPrompt":"你是情绪信息结构化助手。请从用户消息中提取情绪相关信息。\n\n输出以下JSON，不要输出任何其他内容：\n{\n  \"has_emotion\": true或false,\n  \"mood_type\": \"情绪名称，未提及则为空字符串\",\n  \"intensity_candidate\": \"1到5的整数，无法判断则为0\",\n  \"duration_hours\": \"持续小时数，未说明则为0\",\n  \"trigger_summary\": \"诱因摘要，最多80字，未说明则为空字符串\",\n  \"impact_study\": \"对学业的影响，取值：无、轻微、明显，无法判断则为空字符串\",\n  \"impact_life\": \"对生活的影响，取值：无、轻微、明显，无法判断则为空字符串\",\n  \"confidence\": \"0到1的数字，表示对提取结果的确信程度\"\n}\n\n规则：\n- 缺失字段一律返回空字符串或0，绝不编造任何信息\n- intensity_candidate 只是候选值，最终强度由用户自评\n- impact_study 和 impact_life 只能取\"无\"\"轻微\"\"明显\"或空字符串，不能取其他值\n- trigger_summary 最多80字\n- 不输出用户原始文本\n- 不输出markdown代码块标记\n- 只输出纯JSON","temperature":0.3,"topP":0.8,"userPrompt":"{{user_text}}\n\n"},"preNodes":[],"spaceId":53260800,"type":"LLM","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"置信度不低于0.6生成情绪草稿，否则生成追问文本；不写数据表","id":5321606,"innerEndNode":false,"modified":"2026-08-16 11:24:26","name":"置信度判断","nextNodeIds":[5321607],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"置信度判断与展示草稿组装（置信度 >= 0.6 展示草稿，否则追问缺失信息）\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(has_emotion=False, mood_type=\"\", intensity_candidate=0,\n         duration_hours=\"\", trigger_summary=\"\", impact_study=\"\",\n         impact_life=\"\", confidence=0.0):\n    if isinstance(has_emotion, dict):\n        inputs = has_emotion\n        has_emotion = inputs.get(\"has_emotion\", False)\n        mood_type = inputs.get(\"mood_type\", \"\")\n        intensity_candidate = inputs.get(\"intensity_candidate\", 0)\n        duration_hours = inputs.get(\"duration_hours\", \"\")\n        trigger_summary = inputs.get(\"trigger_summary\", \"\")\n        impact_study = inputs.get(\"impact_study\", \"\")\n        impact_life = inputs.get(\"impact_life\", \"\")\n        confidence = inputs.get(\"confidence_score\", inputs.get(\"confidence\", 0))\n\n\n    has_emotion = scalar(has_emotion, False)\n    if isinstance(has_emotion, str):\n        has_emotion = has_emotion.strip().lower() == \"true\"\n    mood_type = str(scalar(mood_type, \"\") or \"\")\n    intensity_candidate = scalar(intensity_candidate, 0) or 0\n    duration_hours = str(scalar(duration_hours, \"\") or \"\")\n    trigger_summary = str(scalar(trigger_summary, \"\") or \"\")\n    impact_study = str(scalar(impact_study, \"\") or \"\")\n    impact_life = str(scalar(impact_life, \"\") or \"\")\n    try:\n        score = float(scalar(confidence, 0) or 0)\n    except (TypeError, ValueError):\n        score = 0.0\n\n    if not has_emotion:\n        return {\n            \"show_draft\": False,\n            \"need_followup\": False,\n            \"draft_text\": \"\",\n            \"followup_text\": \"我在你的消息中没有感受到明确的情绪。\"\n                             \"如果你愿意，可以描述一下现在的感受吗？\",\n        }\n\n    if score < 0.6:\n        missing = []\n        if not duration_hours:\n            missing.append(\"持续了多久\")\n        if not trigger_summary:\n            missing.append(\"是什么让你有这样的感受\")\n        if not impact_study:\n            missing.append(\"对学习有没有影响\")\n\n        followup = \"我感受到了你的情绪。为了更好地记录，能再告诉我：\"\n        if missing:\n            followup = followup + \"；\".join(missing) + \"。\"\n\n        partial = '我初步感受到你可能是\"%s\"。' % mood_type\n        if intensity_candidate:\n            partial += \"强度大约%s分（1-5）。\" % intensity_candidate\n\n        return {\n            \"show_draft\": False,\n            \"need_followup\": True,\n            \"draft_text\": partial,\n            \"followup_text\": followup,\n        }\n\n    draft_parts = [\"情绪：%s\" % mood_type]\n    if intensity_candidate:\n        draft_parts.append(\"建议强度（待你确认）：%s/5\" % intensity_candidate)\n    if duration_hours:\n        draft_parts.append(\"持续时间：约%s小时\" % duration_hours)\n    if trigger_summary:\n        draft_parts.append(\"诱因：%s\" % trigger_summary)\n    if impact_study:\n        draft_parts.append(\"对学业的影响：%s\" % impact_study)\n    if impact_life:\n        draft_parts.append(\"对生活的影响：%s\" % impact_life)\n\n    draft_text = \"\\n\".join(draft_parts)\n    draft_text += \"\\n\\n请确认或修改以上内容。强度分数由你自己评定（1-5）。\"\n\n    return {\n        \"show_draft\": True,\n        \"need_followup\": False,\n        \"draft_text\": draft_text,\n        \"followup_text\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1540,"width":220,"y":40,"height":79},"inputArgs":[{"bindValue":"5321605.has_emotion","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"has_emotion","require":false,"systemVariable":false},{"bindValue":"5321605.mood_type","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"mood_type","require":false,"systemVariable":false},{"bindValue":"5321605.intensity_candidate","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"intensity_candidate","require":false,"systemVariable":false},{"bindValue":"5321605.duration_hours","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"5321605.trigger_summary","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5321605.impact_study","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"impact_study","require":false,"systemVariable":false},{"bindValue":"5321605.impact_life","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"impact_life","require":false,"systemVariable":false},{"bindValue":"5321605.confidence","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"confidence","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"show_draft","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"need_followup","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"draft_text","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"followup_text","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257591},{"created":"2026-08-16 11:20:06","description":"归并危机拦截分支与情绪抽取分支的输出","id":5321607,"innerEndNode":false,"modified":"2026-08-16 11:24:26","name":"最终输出整理","nextNodeIds":[5321608],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"最终输出整理：归并危机拦截分支与情绪抽取分支\"\"\"\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(crisis_signal_detected=False, crisis_response=\"\",\n         llm_has_emotion=False, llm_mood_type=\"\", llm_intensity_candidate=0,\n         llm_duration_hours=\"\", llm_trigger_summary=\"\", llm_impact_study=\"\",\n         llm_impact_life=\"\", llm_confidence=0.0, judge_show_draft=False,\n         judge_need_followup=False, judge_draft_text=\"\", judge_followup_text=\"\"):\n    if isinstance(crisis_signal_detected, dict):\n        inputs = crisis_signal_detected\n        crisis_signal_detected = inputs.get(\"crisis_signal_detected\", False)\n        crisis_response = inputs.get(\"crisis_response\", \"\")\n        llm_has_emotion = inputs.get(\"llm_has_emotion\", False)\n        llm_mood_type = inputs.get(\"llm_mood_type\", \"\")\n        llm_intensity_candidate = inputs.get(\"llm_intensity_candidate\", 0)\n        llm_duration_hours = inputs.get(\"llm_duration_hours\", \"\")\n        llm_trigger_summary = inputs.get(\"llm_trigger_summary\", \"\")\n        llm_impact_study = inputs.get(\"llm_impact_study\", \"\")\n        llm_impact_life = inputs.get(\"llm_impact_life\", \"\")\n        llm_confidence = inputs.get(\"llm_confidence\", 0.0)\n        judge_show_draft = inputs.get(\"judge_show_draft\", False)\n        judge_need_followup = inputs.get(\"judge_need_followup\", False)\n        judge_draft_text = inputs.get(\"judge_draft_text\", \"\")\n        judge_followup_text = inputs.get(\"judge_followup_text\", \"\")\n\n\n    crisis_signal_detected = scalar(crisis_signal_detected, False)\n    crisis_response = str(scalar(crisis_response, \"\") or \"\")\n    llm_has_emotion = scalar(llm_has_emotion, False)\n    if isinstance(llm_has_emotion, str):\n        llm_has_emotion = llm_has_emotion.strip().lower() == \"true\"\n    llm_mood_type = str(scalar(llm_mood_type, \"\") or \"\")\n    llm_intensity_candidate = scalar(llm_intensity_candidate, 0) or 0\n    llm_duration_hours = str(scalar(llm_duration_hours, \"\") or \"\")\n    llm_trigger_summary = str(scalar(llm_trigger_summary, \"\") or \"\")\n    llm_impact_study = str(scalar(llm_impact_study, \"\") or \"\")\n    llm_impact_life = str(scalar(llm_impact_life, \"\") or \"\")\n    try:\n        llm_confidence = float(scalar(llm_confidence, 0) or 0)\n    except (TypeError, ValueError):\n        llm_confidence = 0.0\n    judge_show_draft = scalar(judge_show_draft, False)\n    judge_need_followup = scalar(judge_need_followup, False)\n    judge_draft_text = str(scalar(judge_draft_text, \"\") or \"\")\n    judge_followup_text = str(scalar(judge_followup_text, \"\") or \"\")\n\n    if crisis_signal_detected:\n        return {\n            \"crisis_signal_detected\": True,\n            \"crisis_response\": crisis_response,\n            \"has_emotion\": False,\n            \"mood_type\": \"\",\n            \"intensity_candidate\": 0,\n            \"duration_hours\": \"\",\n            \"trigger_summary\": \"\",\n            \"impact_study\": \"\",\n            \"impact_life\": \"\",\n            \"confidence\": 0.0,\n            \"show_draft\": False,\n            \"need_followup\": False,\n            \"draft_text\": crisis_response,\n            \"followup_text\": \"\",\n        }\n\n    return {\n        \"crisis_signal_detected\": False,\n        \"crisis_response\": \"\",\n        \"has_emotion\": llm_has_emotion,\n        \"mood_type\": llm_mood_type,\n        \"intensity_candidate\": llm_intensity_candidate,\n        \"duration_hours\": llm_duration_hours,\n        \"trigger_summary\": llm_trigger_summary,\n        \"impact_study\": llm_impact_study,\n        \"impact_life\": llm_impact_life,\n        \"confidence\": llm_confidence,\n        \"show_draft\": judge_show_draft,\n        \"need_followup\": judge_need_followup,\n        \"draft_text\": judge_draft_text,\n        \"followup_text\": judge_followup_text,\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":60},"extension":{"x":1880,"width":220,"y":-60,"height":79},"inputArgs":[{"bindValue":"5321604.crisis_signal_detected","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false},{"bindValue":"5321604.crisis_response","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"crisis_response","require":false,"systemVariable":false},{"bindValue":"5321605.has_emotion","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"llm_has_emotion","require":false,"systemVariable":false},{"bindValue":"5321605.mood_type","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"llm_mood_type","require":false,"systemVariable":false},{"bindValue":"5321605.intensity_candidate","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"llm_intensity_candidate","require":false,"systemVariable":false},{"bindValue":"5321605.duration_hours","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"llm_duration_hours","require":false,"systemVariable":false},{"bindValue":"5321605.trigger_summary","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"llm_trigger_summary","require":false,"systemVariable":false},{"bindValue":"5321605.impact_study","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"llm_impact_study","require":false,"systemVariable":false},{"bindValue":"5321605.impact_life","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"llm_impact_life","require":false,"systemVariable":false},{"bindValue":"5321605.confidence","bindValueType":"Reference","dataType":"Number","description":"","enable":true,"name":"llm_confidence","require":false,"systemVariable":false},{"bindValue":"5321606.show_draft","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"judge_show_draft","require":false,"systemVariable":false},{"bindValue":"5321606.need_followup","bindValueType":"Reference","dataType":"Boolean","description":"","enable":true,"name":"judge_need_followup","require":false,"systemVariable":false},{"bindValue":"5321606.draft_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"judge_draft_text","require":false,"systemVariable":false},{"bindValue":"5321606.followup_text","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"judge_followup_text","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"name":"crisis_signal_detected","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"crisis_response","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"