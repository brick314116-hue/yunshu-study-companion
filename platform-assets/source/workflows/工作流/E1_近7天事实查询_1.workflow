{"name":"E1_近7天事实查询_1","templateConfig":{"category":"FinanceAndCommerce","created":"2026-08-16 19:50:42","creator":{"userId":1785217701,"userName":"J1nG"},"creatorId":1785217701,"description":"计算近7天区间并生成当前用户mood_log的查询SQL（仅事实查询：不判断趋势、不输出风险等级、不诊断）","endNode":{"created":"2026-08-16 19:50:42","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5321987,"innerEndNode":false,"modified":"2026-08-16 19:50:42","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":640,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5321986.start_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"start_time","require":false,"systemVariable":false},{"bindValue":"5321986.end_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"end_time","require":false,"systemVariable":false},{"bindValue":"5321986.query_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"5321986.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257646},"icon":"https://agent.nuwax.com/api/f/s3/icon/20260731/9bbf0c188a0c4a93a53e160253661348.svg","id":5257646,"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"795e5768-2aec-4938-b472-55bfd4df15be","name":"owner_uid","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"查询天数，默认7，范围1-30","enable":true,"key":"2b9765c1-9d4c-45e9-9980-da786d72168c","name":"days","require":false,"systemVariable":false}],"modified":"2026-08-22 14:18:14","name":"E1_近7天事实查询_1","nodes":[{"created":"2026-08-16 19:50:42","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321985,"innerEndNode":false,"modified":"2026-08-16 19:50:42","name":"开始","nextNodeIds":[5321986],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"795e5768-2aec-4938-b472-55bfd4df15be","name":"owner_uid","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"查询天数，默认7，范围1-30","enable":true,"key":"2b9765c1-9d4c-45e9-9980-da786d72168c","name":"days","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257646},{"created":"2026-08-16 19:50:42","description":"计算近7天区间并生成mood_log查询SQL；导入后可在UI中追加数据查询节点执行","id":5321986,"innerEndNode":false,"modified":"2026-08-20 21:34:02","name":"区间计算与查询SQL","nextNodeIds":[5321987],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    // Build output object, keys must match configured output parameters.\n    return {\n        'key': 'value',\n    };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"近7天事实查询：计算日期区间并生成限定当前用户、过滤过期记录的查询SQL\n（仅事实查询，不做趋势判断、不做风险等级）\"\"\"\nfrom datetime import datetime, timedelta\n\n\ndef scalar(value, default=None):\n    \"\"\"把未执行分支传入的空数组/None 归一化为标量，避免 Data [] does not match configured type\"\"\"\n    if isinstance(value, (list, tuple)):\n        return value[0] if value else default\n    return default if value is None else value\n\n\ndef main(owner_uid=\"\", days=7):\n    if isinstance(owner_uid, dict):\n        inputs = owner_uid\n        owner_uid = inputs.get(\"owner_uid\", \"\")\n        days = inputs.get(\"days\", 7)\n\n\n    owner_uid = str(scalar(owner_uid, \"\") or \"\").strip()\n    try:\n        days_val = int(scalar(days, 7) or 7)\n    except (TypeError, ValueError):\n        days_val = 7\n    if days_val < 1 or days_val > 30:\n        days_val = 7\n\n    end_time = datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    start_time = (datetime.utcnow() - timedelta(days=days_val)).strftime(\n        \"%Y-%m-%dT%H:%M:%SZ\")\n\n    if not owner_uid:\n        return {\n            \"start_time\": start_time,\n            \"end_time\": end_time,\n            \"query_sql\": \"\",\n            \"error_message\": \"缺少用户标识，无法查询\",\n        }\n\n    safe_uid = owner_uid.replace(\"'\", \"''\")\n    query_sql = (\n        \"SELECT id, mood_type, intensity_self, duration_hours, \"\n        \"trigger_summary, created FROM mood_log \"\n        \"WHERE uid = '%s' \"\n        \"AND expires_at > '%s' \"\n        \"AND created >= '%s' \"\n        \"ORDER BY created ASC \"\n        \"LIMIT 50\" % (safe_uid, end_time, start_time)\n    )\n\n    return {\n        \"start_time\": start_time,\n        \"end_time\": end_time,\n        \"query_sql\": query_sql,\n        \"error_message\": \"\",\n    }\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"extension":{"x":320,"width":220,"y":-30,"height":79},"inputArgs":[{"bindValue":"5321985.owner_uid","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"owner_uid","require":false,"systemVariable":false},{"bindValue":"5321985.days","bindValueType":"Reference","dataType":"Integer","description":"","enable":true,"name":"days","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"start_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"end_time","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257646},{"created":"2026-08-16 19:50:42","description":"工作流的最终节点，用于返回工作流运行后的结果信息","id":5321987,"innerEndNode":false,"modified":"2026-08-16 19:50:42","name":"结束","nextNodeIds":[],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":640,"width":220,"y":-30,"height":44},"outputArgs":[{"bindValue":"5321986.start_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"start_time","require":false,"systemVariable":false},{"bindValue":"5321986.end_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"end_time","require":false,"systemVariable":false},{"bindValue":"5321986.query_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"5321986.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"returnType":"VARIABLE"},"preNodes":[],"spaceId":53260800,"type":"End","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257646}],"outputArgs":[{"bindValue":"5321986.start_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"start_time","require":false,"systemVariable":false},{"bindValue":"5321986.end_time","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"end_time","require":false,"systemVariable":false},{"bindValue":"5321986.query_sql","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"query_sql","require":false,"systemVariable":false},{"bindValue":"5321986.error_message","bindValueType":"Reference","dataType":"String","description":"","enable":true,"name":"error_message","require":false,"systemVariable":false}],"publishDate":"2026-08-20 21:34:09","publishStatus":"Published","scope":"Space","spaceId":53260800,"startNode":{"created":"2026-08-16 19:50:42","description":"工作流起始节点，用于设定启动工作流需要的信息","id":5321985,"innerEndNode":false,"modified":"2026-08-16 19:50:42","name":"开始","nextNodeIds":[5321986],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":-30,"height":44},"inputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"用户标识，导入后建议在UI中改绑系统变量 USER_UID","enable":true,"key":"795e5768-2aec-4938-b472-55bfd4df15be","name":"owner_uid","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"查询天数，默认7，范围1-30","enable":true,"key":"2b9765c1-9d4c-45e9-9980-da786d72168c","name":"days","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257646},"systemVariables":[{"dataType":"String","description":"平台用户ID","enable":true,"name":"SYS_USER_ID","require":true,"systemVariable":true},{"dataType":"String","description":"用户唯一标识","enable":true,"name":"USER_UID","require":true,"systemVariable":true},{"dataType":"String","description":"用户语言环境","enable":true,"name":"USER_LANG","require":true,"systemVariable":true},{"dataType":"String","description":"用户名称","enable":true,"name":"USER_NAME","require":true,"systemVariable":true},{"dataType":"String","description":"智能体唯一标识","enable":true,"name":"AGENT_ID","require":true,"systemVariable":true},{"dataType":"String","description":"会话唯一标识","enable":true,"name":"CONVERSATION_ID","require":true,"systemVariable":true},{"dataType":"String","description":"请求唯一标识","enable":true,"name":"REQUEST_ID","require":true,"systemVariable":true},{"dataType":"String","description":"用户消息","enable":true,"name":"AGENT_USER_MSG","require":true,"systemVariable":true},{"dataType":"String","description":"会话上下文消息列表","enable":true,"name":"CHAT_CONTEXT","require":true,"systemVariable":true}],"type":"Workflow"},"type":"Workflow"}