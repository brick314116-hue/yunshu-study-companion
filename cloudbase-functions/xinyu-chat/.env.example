NUWAX_MAIN_AGENT_ID=
# Mood check-in form workflow (POST /api/v1/workflow/{id}/execute). Key can be a dedicated ak-… with workflow scope; falls back to NUWAX_API_KEY.
NUWAX_CHECKIN_WORKFLOW_ID=5257662
NUWAX_WORKFLOW_API_KEY=
# Optional values copied from the Nuwax web conversation when the agent needs a fixed sandbox or skills.
