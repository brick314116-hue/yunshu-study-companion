,"enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5340001.psych_consent","bindValueType":"Reference","dataType":"String","enable":true,"name":"psych_consent","require":false,"systemVariable":false},{"bindValue":"5340001.subject_id","bindValueType":"Reference","dataType":"String","enable":true,"name":"subject_id","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"key":"8d1b3387-3a49-4a69-88ac-8b12f6ada8cc","name":"valid","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"70803a83-26f7-4d3a-b069-8b05f14f2fbb","name":"error_msg","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"9932c517-3b99-446c-9df5-0d979cf87d06","name":"mood_type","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"key":"d39f1902-9ce8-43d7-ba54-5580b6af5f5d","name":"intensity_self","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"532c28f5-1c73-4079-bb87-97cf65fb5df2","name":"trigger_event","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Number","description":"","enable":true,"key":"60d8c366-8ad2-4c9f-92e7-fb5bbe955dea","name":"duration_hours","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"fbcbacc7-6690-4425-9375-4782907759c2","name":"impact_study","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"8b373884-6386-422c-a5eb-e786d91b91bf","name":"impact_life","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"17654932-cb7a-475a-bf00-2a7750e36b23","name":"expires_at","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"f50f5818-8fe0-4ae8-b5ed-3c1d80a2c45c","name":"subject_id","require":false,"systemVariable":false}],"codeJavaScript":"// JS 模板（未使用）\nexport default async function main(args) {\n    return { key: \"value\" };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"\n工作流: 表单情绪打卡保存\n节点: 校验与数据准备\n输入: emotion_name (String), intensity (Integer), trigger_summary (String), psych_consent (String)\n输出: valid (Boolean), error_msg (String), mood_type (String), intensity_self (Integer),\n      trigger_event (String), duration_hours (Number), impact_study (String),\n      impact_life (String), raw_text (String), confidence (Number), expires_at (String)\n\"\"\"\n\ndef main(emotion_name=\"\", intensity=0, trigger_summary=\"\", psych_consent=\"\", subject_id=\"\"):\n    # 兼容字典传参（平台可能把所有输入打包为字典传给第一个参数）\n    if isinstance(emotion_name, dict):\n        inputs = emotion_name\n        emotion_name = inputs.get(\"emotion_name\", \"\")\n        intensity = inputs.get(\"intensity\", 0)\n        trigger_summary = inputs.get(\"trigger_summary\", \"\")\n        psych_consent = inputs.get(\"psych_consent\", \"\")\n        subject_id = inputs.get(\"subject_id\", \"\")\n\n    # ---- 校验逻辑 ----\n    consent_ok = psych_consent == \"accepted\"\n    name_ok = bool((emotion_name or \"\").strip())\n\n    try:\n        intensity_val = int(intensity or 0)\n    except (ValueError, TypeError):\n        intensity_val = 0\n    intensity_ok = 1 <= intensity_val <= 5\n\n    valid = consent_ok and name_ok and intensity_ok\n\n    # ---- 错误信息 ----\n    error_msg = \"\"\n    if not consent_ok:\n        error_msg = \"未通过知情同意校验\"\n    elif not name_ok:\n        error_msg = \"情绪名称不能为空\"\n    elif not intensity_ok:\n        error_msg = \"强度必须在 1-5 之间\"\n\n    # ---- 准备写入数据 ----\n    mood_type = (emotion_name or \"\").strip()\n    trigger_event = (trigger_summary or \"\").strip() or \"未填写\"\n\n    raw_text = f\"情绪打卡: {mood_type}, 强度: {intensity_val}/5\"\n    if trigger_event != \"未填写\":\n        raw_text += f\", 触发原因: {trigger_event}\"\n\n    # ---- 计算过期时间 (7天后, UTC ISO8601) ----\n    from datetime import datetime, timezone, timedelta\n    expires_dt = datetime.now(timezone.utc) + timedelta(days=7)\n    expires_at = expires_dt.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    return {\n        \"valid\": valid,\n        \"error_msg\": error_msg,\n        \"mood_type\": mood_type,\n        \"intensity_self\": intensity_val,\n        \"trigger_event\": trigger_event,\n        \"duration_hours\": 0,\n        \"impact_study\": \"\",\n        \"impact_life\": \"\",\n        \"expires_at\": expires_at,\n        \"subject_id\": (subject_id or \"\").strip(),\n    }\n","extension":{"x":300,"width":220,"y":-88,"height":79}},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 12:00:00","description":"校验通过则写入 mood_log，否则返回错误","id":5340003,"innerEndNode":false,"modified":"2026-08-17 12:00:00","name":"条件分支","nextNodeIds":[5340004,5340006],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"inputArgs":[],"outputArgs":[],"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5340002.valid","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"valid","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"String","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5340004],"uuid":"cd79b350-19ce-4616-83df-411c8c453b00"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5340006],"uuid":"c639ceca-55ec-4caa-ab70-bd8c496b2a68"}],"extension":{"x":600,"width":300,"y":-100,"height":119}},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 12:00:00","description":"情绪记录表（对话+表单共用）","id":5340004,"innerEndNode":false,"modified":"2026-08-17 12:00:00","name":"mood_log","nextNodeIds":[5340005],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"inputArgs":[{"bindValue":"5340002.mood_type","bindValueType":"Reference","dataType":"String","enable":true,"name":"mood_type","require":false,"systemVariable":false,"key":"mood_type"},{"bindValue":"5340002.intensity_self","bindValueType":"Reference","dataType":"Integer","enable":true,"name":"intensity_self","require":false,"systemVariable":false,"key":"intensity_self"},{"bindValue":"5340002.trigger_event","bindValueType":"Reference","dataType":"String","enable":true,"name":"trigger_event","require":false,"systemVariable":false,"key":"trigger_summary"},{"bindValue":"5340002.expires_at","bindValueType":"Reference","dataType":"String","enable":true,"name":"expires_at","require":false,"systemVariable":false,"key":"expires_at"},{"bindValue":"5340002.subject_id","bindValueType":"Reference","dataType":"String","enable":true,"name":"subject_id","require":false,"systemVariable":false,"key":"subject_id"}],"outputArgs":[{"dataType":"Number","description":"Data unique ID","enable":true,"key":"id","name":"id","require":true,"systemVariable":true},{"dataType":"Boolean","description":"是否新增成功","enable":true,"key":"success","name":"success","require":true,"systemVariable":true}],"description":"情绪记录表（对话+表单共用）","extension":{"x":1000,"width":220,"y":-88,"height":79},"icon":"https://agent.nuwax.com/api/f/s3/icon/20260817/checkin.svg","name":"mood_log","tableFields":[{"