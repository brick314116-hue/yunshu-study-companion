,"bindValueType":"Input","dataType":"String","description":"情绪名称（如焦虑、低落、平静等）","enable":true,"key":"456450c2-5b47-4fc9-a694-158b325f46e7","name":"emotion_name","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"情绪强度 1-5","enable":true,"key":"7c58ca62-13fb-4e5f-9130-1c080985bddf","name":"intensity","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"触发原因简述","enable":true,"key":"104140ce-c1e4-4469-b1cb-398bbae40bb5","name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"知情同意状态 accepted/declined","enable":true,"key":"661dc87f-3a2f-4161-9767-975d703db4f2","name":"psych_consent","require":true,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"匿名用户标识（HMAC），用于数据隔离","enable":true,"key":"872096c5-331d-4be0-b539-1990c377b552","name":"subject_id","require":true,"systemVariable":false}],"outputArgs":[],"extension":{"x":30,"width":220,"y":-30.5,"height":44}},"preNodes":[],"spaceId":53260800,"type":"Start","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 12:00:00","description":"校验输入有效性并准备 mood_log 写入数据","id":5340002,"innerEndNode":false,"modified":"2026-08-17 12:00:00","name":"校验与数据准备","nextNodeIds":[5340003],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":10},"inputArgs":[{"bindValue":"5340001.emotion_name","bindValueType":"Reference","dataType":"String","enable":true,"name":"emotion_name","require":false,"systemVariable":false},{"bindValue":"5340001.intensity","bindValueType":"Reference","dataType":"Integer","enable":true,"name":"intensity","require":false,"systemVariable":false},{"bindValue":"5340001.trigger_summary","bindValueType":"Reference","dataType":"String","enable":true,"name":"trigger_summary","require":false,"systemVariable":false},{"bindValue":"5340001.psych_consent","bindValueType":"Reference","dataType":"String","enable":true,"name":"psych_consent","require":false,"systemVariable":false},{"bindValue":"5340001.subject_id","bindValueType":"Reference","dataType":"String","enable":true,"name":"subject_id","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"Boolean","description":"","enable":true,"key":"1c85d2ce-1201-44a7-933b-553b5c6146c9","name":"valid","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"0c6e96e4-3ab8-4df2-8e40-1332c9da7881","name":"error_msg","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"38b54535-9e52-4b45-b998-3e04eabd976b","name":"mood_type","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"Integer","description":"","enable":true,"key":"c50939e2-7218-409e-9aeb-7a070a739e24","name":"intensity_self","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"68106e87-062e-4a97-a0ba-64aa26a10f76","name":"trigger_event","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"8eaa5e61-9667-455b-a89f-bb151506bb13","name":"expires_at","require":false,"systemVariable":false},{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"de4bc100-8937-4cc7-ae30-be2ee94948e4","name":"subject_id","require":false,"systemVariable":false}],"codeJavaScript":"// JS 模板（未使用）\nexport default async function main(args) {\n    return { key: \"value\" };\n}\n","codeLanguage":"Python","codePython":"# -*- coding: utf-8 -*-\n\"\"\"\n工作流: 表单情绪打卡保存\n节点: 校验与数据准备\n输入: emotion_name (String), intensity (Integer), trigger_summary (String), psych_consent (String)\n输出: valid (Boolean), error_msg (String), mood_type (String), intensity_self (Integer),\n      trigger_event (String), duration_hours (Number), impact_study (String),\n      impact_life (String), raw_text (String), confidence (Number), expires_at (String)\n\"\"\"\n\ndef main(emotion_name=\"\", intensity=0, trigger_summary=\"\", psych_consent=\"\", subject_id=\"\"):\n    # 兼容字典传参（平台可能把所有输入打包为字典传给第一个参数）\n    if isinstance(emotion_name, dict):\n        inputs = emotion_name\n        emotion_name = inputs.get(\"emotion_name\", \"\")\n        intensity = inputs.get(\"intensity\", 0)\n        trigger_summary = inputs.get(\"trigger_summary\", \"\")\n        psych_consent = inputs.get(\"psych_consent\", \"\")\n        subject_id = inputs.get(\"subject_id\", \"\")\n\n    # ---- 校验逻辑 ----\n    consent_ok = psych_consent == \"accepted\"\n    name_ok = bool((emotion_name or \"\").strip())\n\n    try:\n        intensity_val = int(intensity or 0)\n    except (ValueError, TypeError):\n        intensity_val = 0\n    intensity_ok = 1 <= intensity_val <= 5\n\n    valid = consent_ok and name_ok and intensity_ok\n\n    # ---- 错误信息 ----\n    error_msg = \"\"\n    if not consent_ok:\n        error_msg = \"未通过知情同意校验\"\n    elif not name_ok:\n        error_msg = \"情绪名称不能为空\"\n    elif not intensity_ok:\n        error_msg = \"强度必须在 1-5 之间\"\n\n    # ---- 准备写入数据 ----\n    mood_type = (emotion_name or \"\").strip()\n    trigger_event = (trigger_summary or \"\").strip() or \"未填写\"\n\n    raw_text = f\"情绪打卡: {mood_type}, 强度: {intensity_val}/5\"\n    if trigger_event != \"未填写\":\n        raw_text += f\", 触发原因: {trigger_event}\"\n\n    # ---- 计算过期时间 (7天后, UTC ISO8601) ----\n    from datetime import datetime, timezone, timedelta\n    expires_dt = datetime.now(timezone.utc) + timedelta(days=7)\n    expires_at = expires_dt.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    return {\n        \"valid\": valid,\n        \"error_msg\": error_msg,\n        \"mood_type\": mood_type,\n        \"intensity_self\": intensity_val,\n        \"trigger_event\": trigger_event,\n        \"expires_at\": expires_at,\n        \"subject_id\": (subject_id or \"\").strip(),\n    }\n","extension":{"x":300,"width":220,"y":-88,"height":79}},"preNodes":[],"spaceId":53260800,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 12:00:00","description":"校验通过则写入 mood_log，否则返回错误","id":5340003,"innerEndNode":false,"modified":"2026-08-17 12:00:00","name":"条件分支","nextNodeIds":[5340004,5340006],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"inputArgs":[],"outputArgs":[],"conditionBranchConfigs":[{"branchType":"IF","conditionArgs":[{"compareType":"EQUAL","firstArg":{"bindValue":"5340002.valid","bindValueType":"Reference","dataType":"Boolean","enable":true,"name":"valid","require":false,"systemVariable":false},"secondArg":{"bindValue":"true","bindValueType":"Input","dataType":"String","enable":true,"require":false,"systemVariable":false}}],"conditionType":"AND","nextNodeIds":[5340004],"uuid":"c4eac031-a1c8-446f-ba51-97646d46e031"},{"branchType":"ELSE","conditionArgs":[],"conditionType":"AND","nextNodeIds":[5340006],"uuid":"dc15ee33-5509-4998-8c10-4e24c6223adb"}],"extension":{"x":600,"width":300,"y":-100,"height":119}},"preNodes":[],"spaceId":53260800,"type":"Condition","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5257662},{"created":"2026-08-17 12:00:00","description":"表单情绪打卡记录表","id":5340004,"innerEndNode":false,"modified":"2026-08-17 12:00:00","name":"mood_checkin","nextNodeIds":[5340005],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"inputArgs":[{"bindValue":"5340002.subject_id","bindValueType":"Reference","dataType":"String","enable":true,"name":"subject_id","require":false,"systemVariable":false,"key":"subject_id"},{"bindValue":"5340002.mood_type","bindValueType":"Reference","dataType":"String","enable":true,"name":"mood_type","require":false,"systemVariable":false,"key":"mood_type"},{"bindValue":"5340002.intensity_self","bindValueType":"Reference","dataType":"Integer","enable":true,"name":"intensity_self","require":false,"systemVariable":false,"key":"intensity_self"},{"bindValue":"5340002.trigger_event","bindValueType":"Reference","dataType":"String","enable":true,"name":"trigger_event","require":false,"systemVariable":false,"key":"trigger_summary"},{"bindValue":"5340002.expires_at","bindValueType":"Reference","dataType":"String","enable":true,"name":"expires_at","require":false,"systemVariable":false,"key":"expires_at"}],"outputArgs":[{"dataType":"Number","description":"Data unique ID","enable":true,"key":"id","name":"id","require":true,"systemVariable":true},{"dataType":"Boolean","description":"是否新增成功","enable":true,"key":"success","name":"success","require":true,"systemVariable":true}],"description":"表单情绪打卡记录表","extension":{"x":1000,"width":220,"y":-88,"height":79},"icon":"https://agent.nuwax.com/api/f/s3/icon/20260817/checkin.svg","name":"mood_checkin","tableFields":[{"dataType":"String","description":"主键ID","enable":true,"key":"id","name":"id","require":true,"systemVariable":true},{"dataType":"String","description":"用户唯一标识","enable":true,"key":"uid","name":"uid","require":true,"systemVariable":true},{"dataType":"String","description":"用户名","enable":true,"key":"user_name","name":"user_name","require":false,"systemVariable":true},{"dataType":"String","description":"用户昵称","enable":true,"key":"nick_name","name":"nick_name","require":false,"systemVariable":true},{"dataType":"String","description":"智能体唯一标识","enable":true,"key":"agent_id","name":"agent_id","require":false,"systemVariable":true},{"dataType":"String","description":"智能体名称","enable":true,"key"